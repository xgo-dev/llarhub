import (
	"os"
	"path/filepath"
	"slices"
	"strings"
)

const consumerSource = `#include "cn-cbor/cn-cbor.h"
#include <stdio.h>

#ifdef USE_CBOR_CONTEXT
#define CBOR_CONTEXT_PARAM , NULL
#else
#define CBOR_CONTEXT_PARAM
#endif

int main(int argc, char *argv[]) {

  struct cn_cbor_errback back;
  const char *buf = "asdf";
  const int len = 4;
  const cn_cbor *ret = cn_cbor_decode((const uint8_t *)buf, len CBOR_CONTEXT_PARAM, &back);
  if (ret) {
    printf("oops 1");
  }

  return 0;
}
`

id "jimsch/cn-cbor"

fromVer "1.0.0"

defaults {
	"shared": "OFF",
	"fPIC": "ON",
}

filter => {
	for name, values in target.options {
		if name != "shared" && name != "fPIC" {
			return false
		}
		for value in values {
			if value != "ON" && value != "OFF" {
				return false
			}
		}
	}
	if slices.contains(target.require["os"], "windows") && target.options["shared"][0] == "ON" {
		return false
	}
	return true
}

onBuild ctx => {
	installDir := ctx.outputDir
	shared := target.options["shared"][0] == "ON"
	fPIC := target.options["fPIC"][0] == "ON"
	windows := slices.contains(target.require["os"], "windows")

	c := cmake.new(ctx.SourceDir, filepath.join(ctx.SourceDir, "_build"), installDir)
	c.define "CMAKE_INSTALL_LIBDIR", "lib"
	// cmake_minimum_required(VERSION 3.0.0) is below CMake 4's floor.
	c.define "CMAKE_POLICY_VERSION_MINIMUM", "3.5"
	c.defineBool "BUILD_SHARED_LIBS", shared
	c.defineBool "CMAKE_POSITION_INDEPENDENT_CODE", fPIC
	c.defineBool "CMAKE_WINDOWS_EXPORT_ALL_SYMBOLS", shared
	c.defineBool "CN_CBOR_FATAL_WARNINGS", false
	c.defineBool "CN_CBOR_COVERALLS", false
	c.defineBool "CN_CBOR_BUILD_TESTS", false
	c.defineBool "CN_CBOR_BUILD_DOCS", false
	c.defineBool "fatal_warnings", false
	c.defineBool "coveralls", false
	c.defineBool "build_tests", false
	c.defineBool "build_docs", false
	c.configure
	c.build
	c.install

	licenseDir := filepath.join(installDir, "licenses")
	os.mkdirAll(licenseDir, 0o755)!
	os.writeFile(filepath.join(licenseDir, "LICENSE"), os.readFile(filepath.join(ctx.SourceDir, "LICENSE"))!, 0o644)!

	// CMake writes prefix, libdir, and includedir from CMAKE_INSTALL_PREFIX.
	// Keep the generated flags and make the installed file relocatable.
	pcPath := filepath.join(installDir, "lib", "pkgconfig", "cn-cbor.pc")
	pc := string(os.readFile(pcPath)!)
	pc = strings.replace(pc, "prefix="+installDir, "prefix=$${pcfiledir}/../..", 1)
	pc = strings.replace(pc, "exec_prefix="+filepath.join(installDir, "bin"), "exec_prefix=$${prefix}", 1)
	pc = strings.replace(pc, "libdir="+filepath.join(installDir, "lib"), "libdir=$${prefix}/lib", 1)
	pc = strings.replace(pc, "includedir="+filepath.join(installDir, "include"), "includedir=$${prefix}/include", 1)
	if windows && !strings.contains(pc, "-lws2_32") {
		lines := pc.split("\n")
		for i, line in lines {
			if line.hasPrefix("Libs:") {
				lines[i] = line + " -lws2_32"
				break
			}
		}
		pc = strings.join(lines, "\n")
	}
	os.writeFile(pcPath, []byte(pc), 0o644)!

	pkgconfig.use installDir
	ctx.setMetadata pkgconfig.lookup("cn-cbor")!
}

onTest ctx => {
	installDir := ctx.outputDir
	testDir := filepath.join(ctx.SourceDir, "_llar_consumer")
	os.mkdirAll(testDir, 0o755)!

	consumer := filepath.join(testDir, "consumer.cpp")
	os.writeFile(consumer, []byte(consumerSource), 0o644)!

	pkgconfig.use installDir
	flagsFile := filepath.join(testDir, "cn-cbor.flags")
	os.writeFile(flagsFile, []byte(pkgconfig.lookup("cn-cbor")!), 0o644)!

	binary := filepath.join(testDir, "consumer")
	exec! "c++", "-std=c++11", consumer, "-o", binary, "@"+flagsFile

	if target.options["shared"][0] == "ON" {
		os.setenv("LD_LIBRARY_PATH", filepath.join(installDir, "lib"))!
		os.setenv("DYLD_LIBRARY_PATH", filepath.join(installDir, "lib"))!
	}
	exec! binary
}
