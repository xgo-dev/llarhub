import (
	"os"
	"path/filepath"
)

const consumerSource = `#include <concurrentqueue.h>

int main(int argc, char **argv) {
    moodycamel::ConcurrentQueue<int> q;
    return 0;
}
`

id "cameron314/concurrentqueue"

fromVer "v1.0.1"

onBuild ctx => {
	installDir := ctx.outputDir
	includeDir := filepath.join(installDir, "include", "moodycamel")
	os.mkdirAll(includeDir, 0o755)!

	for name in ["blockingconcurrentqueue.h", "concurrentqueue.h", "lightweightsemaphore.h"] {
		os.writeFile(filepath.join(includeDir, name), os.readFile(filepath.join(ctx.SourceDir, name))!, 0o644)!
	}

	licenseDir := filepath.join(installDir, "licenses")
	os.mkdirAll(licenseDir, 0o755)!
	os.writeFile(filepath.join(licenseDir, "LICENSE.md"), os.readFile(filepath.join(ctx.SourceDir, "LICENSE.md"))!, 0o644)!

	libs := []string{}
	if target.require["os"][0] == "linux" || target.require["os"][0] == "freebsd" {
		libs <- "-lpthread"
	}

	pcDir := filepath.join(installDir, "lib", "pkgconfig")
	os.mkdirAll(pcDir, 0o755)!
	pc := pkgconfig.new(
		name = "concurrentqueue",
		description = "A fast multi-producer, multi-consumer lock-free concurrent queue for C++11",
		version = "v1.0.1",
		libs = libs,
		cflags = ["-I$${includedir}/moodycamel"],
	)!
	out := os.create(filepath.join(pcDir, "concurrentqueue.pc"))!
	pc.writeTo(out)!
	out.close()!

	pkgconfig.use installDir
	ctx.setMetadata pkgconfig.lookup("concurrentqueue")!
}

onTest ctx => {
	installDir := ctx.outputDir
	testDir := filepath.join(ctx.SourceDir, "_llar_consumer")
	os.mkdirAll(testDir, 0o755)!

	consumer := filepath.join(testDir, "consumer.cpp")
	os.writeFile(consumer, []byte(consumerSource), 0o644)!

	pkgconfig.use installDir
	flagsFile := filepath.join(testDir, "concurrentqueue.flags")
	os.writeFile(flagsFile, []byte(pkgconfig.lookup("concurrentqueue")!), 0o644)!

	binary := filepath.join(testDir, "consumer")
	exec! "c++", "-std=c++11", consumer, "-o", binary, "@"+flagsFile
	exec! binary
}
