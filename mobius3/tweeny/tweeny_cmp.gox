// Upstream publishes historical numeric tags, a v3 alias, the pre-4.0
// snapshot, and v-prefixed semantic releases. Normalize the complete visible
// tag set before comparing it: 1 < 2 < v3 < v3.1.0 < v3.1.1 < v3.2.0 <
// v3.2.1 < pre-4.0 < v4.0.0 < v4.1.0.
func normalize(version string) string {
	switch version {
	case "1":
		return "v1.0.0"
	case "2":
		return "v2.0.0"
	case "v3":
		return "v3.0.0"
	case "pre-4.0":
		return "v4.0.0-0"
	}
	return version
}

compareVer (a, b) => {
	return semver.Compare(normalize(a.Version), normalize(b.Version))
}
