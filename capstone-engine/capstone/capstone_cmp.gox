import "strings"

func normalize(version string) string {
	if version == "5.0-post1" {
		return "5.0.0.1"
	}
	for prefix in ["2.0", "2.1", "3.0", "4.0", "5.0"] {
		marker := prefix + "-"
		if strings.hasPrefix(version, marker) {
			return strings.replace(version, marker, prefix+".0~", 1)
		}
	}
	return strings.replace(version, "-", "~", 1)
}

compareVer (a, b) => {
	return gnu.Compare(normalize(a.Version), normalize(b.Version))
}
