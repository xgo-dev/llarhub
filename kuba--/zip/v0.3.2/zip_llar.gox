import (
	"os"
	"path/filepath"
	"strings"
)

const consumerSource = `#include <zip/zip.h>

int main(void) {
    struct zip_t *z = zip_open("x.zip", 0, 'w');
    if (z) {
        zip_close(z);
    }
    return 0;
}
`

id "kuba--/zip"

fromVer "v0.3.2"

defaults {
	"shared": "OFF",
	"fPIC": "ON",
}

filter => {
	for name, values in target.options {
		if name != "shared" && name != "fPIC" {
			return false
		}
		for value in values {
			if value != "ON" && value != "OFF" {
				return false
			}
		}
	}
	return true
}

onBuild ctx => {
	installDir := ctx.outputDir
	shared := target.options["shared"][0] == "ON"
	fPIC := target.options["fPIC"][0] == "ON"

	cmakeLists := filepath.join(ctx.SourceDir, "CMakeLists.txt")
	source := string(os.readFile(cmakeLists)!)
	source = strings.replace(source, "-Werror", "", 1)
	os.writeFile(cmakeLists, []byte(source), 0o644)!

	c := cmake.new(ctx.SourceDir, filepath.join(ctx.SourceDir, "_build"), installDir)
	c.defineBool "CMAKE_DISABLE_TESTING", true
	c.defineBool "ZIP_STATIC_PIC", fPIC
	c.defineBool "ZIP_BUILD_DOCS", false
	c.defineBool "BUILD_SHARED_LIBS", shared
	c.configure
	c.build
	c.install

	licenseDir := filepath.join(installDir, "licenses")
	os.mkdirAll(licenseDir, 0o755)!
	for name in []string{"UNLICENSE", "LICENSE.txt"} {
		licensePath := filepath.join(ctx.SourceDir, name)
		if _, err := os.stat(licensePath); err == nil {
			os.writeFile(filepath.join(licenseDir, name), os.readFile(licensePath)!, 0o644)!
		} else if !os.isNotExist(err) {
			panic err
		}
	}

	version := ""
	for line in source.split("\n") {
		if line.contains(`VERSION "`) {
			version = line.split(`"`)[1]
			break
		}
	}
	if version == "" {
		panic "zip CMakeLists.txt has no project version"
	}

	cflags := "-I$${includedir}"
	if shared {
		cflags += " -DZIP_SHARED"
	}
	pcDir := filepath.join(installDir, "lib", "pkgconfig")
	os.mkdirAll(pcDir, 0o755)!
	pc := `prefix=$${pcfiledir}/../..
exec_prefix=$${prefix}
libdir=$${prefix}/lib
includedir=$${prefix}/include

Name: zip
Description: A portable, simple zip library written in C
Version: ` + version + `
Libs: -L$${libdir} -lzip
Cflags: ` + cflags + `
`
	os.writeFile(filepath.join(pcDir, "zip.pc"), []byte(pc), 0o644)!

	pkgconfig.use installDir
	ctx.setMetadata pkgconfig.lookup("zip")!
}

onTest ctx => {
	installDir := ctx.outputDir
	testDir := filepath.join(ctx.SourceDir, "_llar_consumer")
	os.mkdirAll(testDir, 0o755)!

	consumer := filepath.join(testDir, "consumer.c")
	os.writeFile(consumer, []byte(consumerSource), 0o644)!

	pkgconfig.use installDir
	flagsFile := filepath.join(testDir, "zip.flags")
	os.writeFile(flagsFile, []byte(pkgconfig.lookup("zip")!), 0o644)!

	binary := filepath.join(testDir, "consumer")
	cc! consumer, "-o", binary, "@"+flagsFile

	if target.options["shared"][0] == "ON" {
		os.setenv("LD_LIBRARY_PATH", filepath.join(installDir, "lib"))!
		os.setenv("DYLD_LIBRARY_PATH", filepath.join(installDir, "lib"))!
	}
	exec! binary
}
