import (
	"os"
	"path/filepath"
)

const consumerSource = `#include <perfetto.h>

int main() {
  perfetto::TracingInitArgs args;

  // The backends determine where trace events are recorded. You may select one
  // or more of:

  // 1) The in-process backend only records within the app itself.
  args.backends |= perfetto::kInProcessBackend;

  // 2) The system backend writes events into a system Perfetto daemon,
  //    allowing merging app and system events on the same timeline. Requires
  //    the Perfetto traced daemon to be running.
  args.backends |= perfetto::kSystemBackend;

  perfetto::Tracing::Initialize(args);
  return 0;
}
`

id "google/perfetto"

fromVer "v40.0"

defaults {
	"shared": "OFF",
	"fPIC": "ON",
	"disable_logging": "OFF",
}

filter => {
	for name, values in target.options {
		if name != "shared" && name != "fPIC" && name != "disable_logging" {
			return false
		}
		for value in values {
			if value != "ON" && value != "OFF" {
				return false
			}
		}
	}
	return true
}

onBuild ctx => {
	installDir := ctx.outputDir

	cmakeLists := ctx.Proj.readFile("CMakeLists.txt")!
	os.writeFile(filepath.join(ctx.SourceDir, "CMakeLists.txt"), cmakeLists, 0o644)!

	shared := target.options["shared"][0] == "ON"
	fPIC := target.options["fPIC"][0] == "ON"
	disableLogging := target.options["disable_logging"][0] == "ON"

	c := cmake.new(ctx.SourceDir, filepath.join(ctx.SourceDir, "_build"), installDir)
	c.define "CMAKE_INSTALL_LIBDIR", "lib"
	c.define "PERFETTO_CXX_STANDARD", "cxx_std_17"
	c.define "PERFETTO_SRC_DIR", ctx.SourceDir
	c.defineBool "BUILD_SHARED_LIBS", shared
	c.defineBool "CMAKE_POSITION_INDEPENDENT_CODE", fPIC
	c.defineBool "PERFETTO_DISABLE_LOGGING", disableLogging
	c.configure
	c.build
	c.install

	licenseDir := filepath.join(installDir, "licenses")
	os.mkdirAll(licenseDir, 0o755)!
	os.writeFile(filepath.join(licenseDir, "LICENSE"), os.readFile(filepath.join(ctx.SourceDir, "LICENSE"))!, 0o644)!

	libs := ["-L$${libdir}", "-lperfetto"]
	osName := target.require["os"][0]
	if osName == "linux" || osName == "freebsd" {
		libs <- "-lpthread"
		libs <- "-lm"
	} else if osName == "windows" {
		libs <- "-lws2_32"
	}

	pcDir := filepath.join(installDir, "lib", "pkgconfig")
	os.mkdirAll(pcDir, 0o755)!
	pc := pkgconfig.new(
		name = "perfetto",
		description = "Performance instrumentation and tracing for Android, Linux and Chrome",
		version = "v40.0",
		libs = libs,
		cflags = ["-I$${includedir}"],
	)!
	out := os.create(filepath.join(pcDir, "perfetto.pc"))!
	pc.writeTo(out)!
	out.close()!

	pkgconfig.use installDir
	ctx.setMetadata pkgconfig.lookup("perfetto")!
}

onTest ctx => {
	installDir := ctx.outputDir
	testDir := filepath.join(ctx.SourceDir, "_llar_consumer")
	os.mkdirAll(testDir, 0o755)!

	consumer := filepath.join(testDir, "consumer.cpp")
	os.writeFile(consumer, []byte(consumerSource), 0o644)!

	pkgconfig.use installDir
	flags := pkgconfig.lookup("perfetto")!
	flagsFile := filepath.join(testDir, "perfetto.flags")
	os.writeFile(flagsFile, []byte(flags), 0o644)!

	binary := filepath.join(testDir, "consumer")
	exec! "c++", "-std=c++17", consumer, "-o", binary, "@"+flagsFile

	if target.options["shared"][0] == "ON" {
		os.setenv("LD_LIBRARY_PATH", filepath.join(installDir, "lib"))!
		os.setenv("DYLD_LIBRARY_PATH", filepath.join(installDir, "lib"))!
	}
	exec! binary
}
