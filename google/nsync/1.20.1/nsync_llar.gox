import (
	"os"
	"path/filepath"
	"strings"
)

const consumerC = `#include <nsync.h>
#include <nsync_counter.h>
#include <nsync_debug.h>
#include <nsync_note.h>
#include <nsync_once.h>
#include <nsync_time.h>
#include <nsync_waiter.h>

#include <stdio.h>
#include <string.h>

static int once_ran;
static int value_is_one(const void *arg) {
	return *(const int *)arg == 1;
}

static void mark_once(void) {
	once_ran = 1;
}

int main(void) {
	nsync_mu mu = NSYNC_MU_INIT;
	nsync_cv cv = NSYNC_CV_INIT;
	nsync_once once = NSYNC_ONCE_INIT;
	int ready = 1;
	char debug[64];
	nsync_time now;
	nsync_time later;
	nsync_counter counter;
	nsync_note note;
	struct nsync_waitable_s waitable;
	struct nsync_waitable_s *waitables[1];
	int waited;

	nsync_mu_init(&mu);
	if (!nsync_mu_trylock(&mu)) {
		return 1;
	}
	nsync_mu_assert_held(&mu);
	nsync_mu_unlock(&mu);

	nsync_mu_lock(&mu);
	nsync_mu_unlock(&mu);

	nsync_mu_rlock(&mu);
	if (!nsync_mu_is_reader(&mu)) {
		return 2;
	}
	nsync_mu_rassert_held(&mu);
	nsync_mu_runlock(&mu);

	nsync_cv_init(&cv);
	nsync_mu_lock(&mu);
	if (nsync_cv_wait_with_deadline(&cv, &mu, nsync_time_zero, NULL) == 0) {
		return 3;
	}
	nsync_mu_wait(&mu, &value_is_one, &ready, NULL);
	nsync_cv_signal(&cv);
	nsync_cv_broadcast(&cv);
	nsync_mu_unlock(&mu);

	nsync_run_once(&once, &mark_once);
	nsync_run_once(&once, &mark_once);
	if (!once_ran) {
		return 4;
	}

	counter = nsync_counter_new(1);
	if (counter == NULL || nsync_counter_value(counter) != 1) {
		return 5;
	}
	if (nsync_counter_add(counter, -1) != 0) {
		return 6;
	}
	if (nsync_counter_wait(counter, nsync_time_zero) != 0) {
		return 7;
	}
	nsync_counter_free(counter);

	note = nsync_note_new(NULL, nsync_time_zero);
	if (note == NULL || !nsync_note_is_notified(note)) {
		return 8;
	}
	nsync_note_notify(note);
	if (!nsync_note_wait(note, nsync_time_no_deadline)) {
		return 9;
	}

	now = nsync_time_now();
	later = nsync_time_add(now, nsync_time_ms(1));
	if (nsync_time_cmp(later, now) <= 0) {
		return 10;
	}
	if (nsync_time_cmp(nsync_time_sub(later, now), nsync_time_zero) <= 0) {
		return 11;
	}
	(void)nsync_time_sleep(nsync_time_zero);
	(void)nsync_time_us(1);
	(void)nsync_time_s_ns(0, 1);

	waitable.v = note;
	waitable.funcs = &nsync_note_waitable_funcs;
	waitables[0] = &waitable;
	waited = nsync_wait_n(NULL, NULL, NULL, nsync_time_no_deadline, 1, waitables);
	nsync_note_free(note);
	if (waited != 0) {
		return 12;
	}

	if (nsync_mu_debug_state(&mu, debug, (int)sizeof(debug)) == NULL) {
		return 13;
	}
	if (nsync_cv_debug_state(&cv, debug, (int)sizeof(debug)) == NULL) {
		return 14;
	}
	if (strlen(debug) >= sizeof(debug)) {
		return 15;
	}

	printf("nsync c ok\n");
	return 0;
}
`

const consumerCXX = `#include <nsync.h>
#include <nsync_counter.h>
#include <nsync_note.h>
#include <nsync_once.h>
#include <nsync_time.h>
#include <nsync_waiter.h>

#include <cstdio>

static int once_ran;
static int value_is_one(const void *arg) {
	return *static_cast<const int *>(arg) == 1;
}

static void mark_once(void) {
	once_ran = 1;
}

int main() {
	nsync::nsync_mu mu = NSYNC_MU_INIT;
	nsync::nsync_cv cv = NSYNC_CV_INIT;
	nsync::nsync_once once = NSYNC_ONCE_INIT;
	int ready = 1;

	nsync::nsync_mu_init(&mu);
	nsync::nsync_mu_lock(&mu);
	nsync::nsync_mu_unlock(&mu);
	if (!nsync::nsync_mu_trylock(&mu)) {
		return 1;
	}
	nsync::nsync_mu_unlock(&mu);

	nsync::nsync_mu_rlock(&mu);
	nsync::nsync_mu_runlock(&mu);

	nsync::nsync_cv_init(&cv);
	nsync::nsync_mu_lock(&mu);
	if (nsync::nsync_cv_wait_with_deadline(&cv, &mu, nsync::nsync_time_zero, NULL) == 0) {
		return 2;
	}
	nsync::nsync_mu_wait(&mu, &value_is_one, &ready, NULL);
	nsync::nsync_cv_signal(&cv);
	nsync::nsync_cv_broadcast(&cv);
	nsync::nsync_mu_unlock(&mu);

	nsync::nsync_run_once(&once, &mark_once);
	if (!once_ran) {
		return 3;
	}

	nsync::nsync_counter counter = nsync::nsync_counter_new(2);
	if (counter == NULL || nsync::nsync_counter_add(counter, -2) != 0) {
		return 4;
	}
	if (nsync::nsync_counter_wait(counter, nsync::nsync_time_zero) != 0) {
		return 5;
	}
	nsync::nsync_counter_free(counter);

	nsync::nsync_note note = nsync::nsync_note_new(NULL, nsync::nsync_time_zero);
	if (note == NULL || !nsync::nsync_note_is_notified(note)) {
		return 6;
	}
	nsync::nsync_waitable_s waitable;
	waitable.v = note;
	waitable.funcs = &nsync::nsync_note_waitable_funcs;
	nsync::nsync_waitable_s *waitables[1] = {&waitable};
	if (nsync::nsync_wait_n(NULL, NULL, NULL, nsync::nsync_time_no_deadline, 1, waitables) != 0) {
		return 7;
	}
	nsync::nsync_note_free(note);

	if (nsync::nsync_time_cmp(nsync::nsync_time_now(), nsync::nsync_time_zero) < 0) {
		return 8;
	}

	std::printf("nsync cpp ok\n");
	return 0;
}
`

id "google/nsync"

fromVer "1.20.1"

defaults {
	"shared": "OFF",
	"fPIC": "ON",
}

filter => {
	for name, values in target.options {
		if name != "shared" && name != "fPIC" {
			return false
		}
		for value in values {
			if value != "ON" && value != "OFF" {
				return false
			}
		}
	}
	return true
}

onBuild ctx => {
	installDir := ctx.outputDir
	shared := target.options["shared"][0] == "ON"
	fPIC := target.options["fPIC"][0] == "ON"
	osName := target.require["os"][0]

	cmakeLists := filepath.join(ctx.SourceDir, "CMakeLists.txt")
	source := string(os.readFile(cmakeLists)!)
	source = strings.replace(source, "set (CMAKE_POSITION_INDEPENDENT_CODE ON)\n", "", 1)
	source = strings.replace(source, "\"platform/c++11/src/nsync_semaphore_mutex.cc\"\n\t\t\"platform/posix/src/clock_gettime.c\"\n\t\t\"platform/posix/src/nsync_semaphore_mutex.c\"", "\"platform/c++11/src/nsync_semaphore_mutex.cc\"\n\t\t\"platform/posix/src/clock_gettime.c\"", 1)
	os.writeFile(cmakeLists, []byte(source), 0o644)!

	c := cmake.new(ctx.SourceDir, filepath.join(ctx.SourceDir, "_build"), installDir)
	c.buildType "Release"
	c.define "CMAKE_INSTALL_LIBDIR", "lib"
	c.define "CMAKE_POLICY_VERSION_MINIMUM", "3.5"
	c.defineBool "BUILD_SHARED_LIBS", shared
	c.defineBool "CMAKE_POSITION_INDEPENDENT_CODE", fPIC
	c.defineBool "NSYNC_ENABLE_TESTS", false
	if osName == "windows" && shared {
		c.defineBool "CMAKE_WINDOWS_EXPORT_ALL_SYMBOLS", true
	}
	c.configure
	c.build
	c.install

	licenseDir := filepath.join(installDir, "licenses")
	os.mkdirAll(licenseDir, 0o755)!
	os.writeFile(filepath.join(licenseDir, "LICENSE"), os.readFile(filepath.join(ctx.SourceDir, "LICENSE"))!, 0o644)!

	nsyncLibs := ["-L$${libdir}", "-lnsync"]
	nsyncCppLibs := ["-L$${libdir}", "-lnsync_cpp"]
	if osName == "linux" || osName == "freebsd" {
		nsyncLibs <- "-lpthread"
		nsyncCppLibs <- "-lm"
		nsyncCppLibs <- "-lpthread"
	}

	pcDir := filepath.join(installDir, "lib", "pkgconfig")
	os.mkdirAll(pcDir, 0o755)!

	nsyncPC := pkgconfig.new(
		name = "nsync",
		description = "Library that exports various synchronization primitives",
		version = "1.20.1",
		libs = nsyncLibs,
		cflags = ["-I$${includedir}"],
	)!
	nsyncOut := os.create(filepath.join(pcDir, "nsync.pc"))!
	nsyncPC.writeTo(nsyncOut)!
	nsyncOut.close()!

	nsyncCppPC := pkgconfig.new(
		name = "nsync_cpp",
		description = "C++ build of nsync synchronization primitives",
		version = "1.20.1",
		libs = nsyncCppLibs,
		cflags = ["-I$${includedir}", "-DNSYNC_ATOMIC_CPP11", "-DNSYNC_USE_CPP11_TIMEPOINT"],
	)!
	nsyncCppOut := os.create(filepath.join(pcDir, "nsync_cpp.pc"))!
	nsyncCppPC.writeTo(nsyncCppOut)!
	nsyncCppOut.close()!

	pkgconfig.use installDir
	pkgconfig.lookup("nsync_cpp")!
	ctx.setMetadata pkgconfig.lookup("nsync")!
}

onTest ctx => {
	installDir := ctx.outputDir
	testDir := filepath.join(ctx.SourceDir, "_llar_consumer")
	os.mkdirAll(testDir, 0o755)!

	consumer := filepath.join(testDir, "consumer.c")
	os.writeFile(consumer, []byte(consumerC), 0o644)!
	consumerCpp := filepath.join(testDir, "consumer.cpp")
	os.writeFile(consumerCpp, []byte(consumerCXX), 0o644)!

	pkgconfig.use installDir
	cFlags := filepath.join(testDir, "nsync.flags")
	os.writeFile(cFlags, []byte(pkgconfig.lookup("nsync")!), 0o644)!
	cxxFlags := filepath.join(testDir, "nsync_cpp.flags")
	os.writeFile(cxxFlags, []byte(pkgconfig.lookup("nsync_cpp")!), 0o644)!

	cBin := filepath.join(testDir, "consumer")
	cxxBin := filepath.join(testDir, "consumer_cpp")
	cc! consumer, "-o", cBin, "@"+cFlags
	exec! "c++", "-std=c++11", consumerCpp, "-o", cxxBin, "@"+cxxFlags

	if target.options["shared"][0] == "ON" {
		os.setenv("LD_LIBRARY_PATH", filepath.join(installDir, "lib"))!
		os.setenv("DYLD_LIBRARY_PATH", filepath.join(installDir, "lib"))!
	}
	exec! cBin
	exec! cxxBin
}
