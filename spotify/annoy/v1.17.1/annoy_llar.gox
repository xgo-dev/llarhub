import (
	"os"
	"path/filepath"
)

const consumerSource = `#include <annoy/annoylib.h>
#include <annoy/kissrandom.h>

#include <iostream>
#include <vector>

int main() {
    const int n = 3;
    Annoy::AnnoyIndex<int, double, Annoy::Angular, Annoy::Kiss32Random, Annoy::AnnoyIndexSingleThreadedBuildPolicy> index(n);

    double x[3][3] = {{1, 0, 0}, {0, 1, 0}, {0, 0, 1}};
    double needle[3] = {0.1, 0.1, 0.8};

    for (int i = 0; i < n; i++) {
        index.add_item(i, x[i]);
    }
    index.build(-1);

    std::vector<int> result;
    index.get_nns_by_vector(needle, 1, -1, &result, nullptr);
    std::cout << "Nearest neighbor to vector [1.0, 0.5, 0.5]: ";
    for (int i : result) {
        std::cout << i << " ";
    }
    std::cout << std::endl;
    return 0;
}
`

id "spotify/annoy"

fromVer "v1.17.1"

onBuild ctx => {
	installDir := ctx.outputDir
	includeDir := filepath.join(installDir, "include", "annoy")
	os.mkdirAll(includeDir, 0o755)!
	for name in []string{"annoylib.h", "kissrandom.h", "mman.h"} {
		source := filepath.join(ctx.SourceDir, "src", name)
		os.writeFile(filepath.join(includeDir, name), os.readFile(source)!, 0o644)!
	}

	licenseDir := filepath.join(installDir, "licenses")
	os.mkdirAll(licenseDir, 0o755)!
	os.writeFile(filepath.join(licenseDir, "LICENSE"), os.readFile(filepath.join(ctx.SourceDir, "LICENSE"))!, 0o644)!
}

onTest ctx => {
	testDir := filepath.join(ctx.SourceDir, "_llar_consumer")
	os.mkdirAll(testDir, 0o755)!

	source := filepath.join(testDir, "consumer.cpp")
	os.writeFile(source, []byte(consumerSource), 0o644)!

	binary := filepath.join(testDir, "consumer")
	exec! "c++", "-std=c++11", "-I", filepath.join(ctx.outputDir, "include"), source, "-o", binary
	exec! binary
}
