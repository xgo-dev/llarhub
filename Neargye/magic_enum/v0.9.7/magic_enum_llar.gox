import (
	"os"
	"path/filepath"
)

const consumerSource = `#include <magic_enum/magic_enum.hpp>
#include <cstdlib>
#include <string>

enum Color { RED = 2, BLUE = 4, GREEN = 8 };

int main() {
    Color color = Color::RED;
    std::string colorName { magic_enum::enum_name(color) };
    return colorName == "RED" ? EXIT_SUCCESS : EXIT_FAILURE;
}
`

id "Neargye/magic_enum"

// v0.9.7 changed the public header layout and uses CMAKE_INSTALL_DATAROOTDIR
// for CMake and pkg-config metadata.
fromVer "v0.9.7"

onBuild ctx => {
	installDir := ctx.outputDir

	c := cmake.new(ctx.SourceDir, filepath.join(ctx.SourceDir, "_build"), installDir)
	c.define "CMAKE_INSTALL_LIBDIR", "lib"
	c.define "CMAKE_INSTALL_DATAROOTDIR", "lib"
	c.defineBool "MAGIC_ENUM_OPT_BUILD_EXAMPLES", false
	c.defineBool "MAGIC_ENUM_OPT_BUILD_TESTS", false
	c.defineBool "MAGIC_ENUM_OPT_INSTALL", true
	c.configure
	c.build
	c.install

	licenseDir := filepath.join(installDir, "licenses")
	os.mkdirAll(licenseDir, 0o755)!
	os.writeFile(filepath.join(licenseDir, "LICENSE"), os.readFile(filepath.join(ctx.SourceDir, "LICENSE"))!, 0o644)!

	pcDir := filepath.join(installDir, "lib", "pkgconfig")
	os.mkdirAll(pcDir, 0o755)!
	pc := pkgconfig.new(
		name = "magic_enum",
		description = "A library that provides static reflection for enums, work with any enum type without any macro or boilerplate code.",
		version = "v0.9.7",
		cflags = ["-I$${includedir}"],
	)!
	out := os.create(filepath.join(pcDir, "magic_enum.pc"))!
	pc.writeTo(out)!
	out.close()!

	pkgconfig.use installDir
	ctx.setMetadata pkgconfig.lookup("magic_enum")!
}

onTest ctx => {
	installDir := ctx.outputDir
	testDir := filepath.join(ctx.SourceDir, "_llar_consumer")
	buildDir := filepath.join(testDir, "_build")
	os.mkdirAll(buildDir, 0o755)!

	sourcePath := filepath.join(testDir, "consumer.cpp")
	os.writeFile(sourcePath, []byte(consumerSource), 0o644)!

	pkgconfig.use installDir
	flagsFile := filepath.join(testDir, "magic_enum.flags")
	os.writeFile(flagsFile, []byte(pkgconfig.lookup("magic_enum")!), 0o644)!

	binary := filepath.join(buildDir, "consumer")
	exec! "c++", "-std=c++17", sourcePath, "-o", binary, "@"+flagsFile
	exec! binary
}
