import (
	"os"
	"path/filepath"
	"slices"
	"strings"
)

const consumerSource = `#include <json/json.h>
#include <iostream>

int main()
{
    Json::Value value("Hello, World");
    std::cout << value.asString() << std::endl;
    return 0;
}
`

id "open-source-parsers/jsoncpp"

fromVer "1.8.3"

defaults {
	"shared": "OFF",
	"fPIC": "ON",
}

filter => {
	for name, values in target.options {
		if name != "shared" && name != "fPIC" {
			return false
		}
		for value in values {
			if value != "ON" && value != "OFF" {
				return false
			}
		}
	}
	return true
}

onBuild ctx => {
	installDir := ctx.outputDir
	shared := target.options["shared"][0] == "ON"
	fPIC := target.options["fPIC"][0] == "ON"

	valueSourcePath := filepath.join(ctx.SourceDir, "src", "lib_json", "json_value.cpp")
	valueSource := string(os.readFile(valueSourcePath)!)
	valueSource = strings.replace(
		valueSource,
		`return d >= min && d <= max;`,
		`return d >= static_cast<double>(min) && d <= static_cast<double>(max);`,
		1,
	)
	os.writeFile(valueSourcePath, []byte(valueSource), 0o644)!

	c := cmake.new(ctx.SourceDir, filepath.join(ctx.SourceDir, "_build"), installDir)
	c.define "CMAKE_INSTALL_LIBDIR", "lib"
	c.define "CMAKE_POLICY_VERSION_MINIMUM", "3.5"
	c.defineBool "BUILD_SHARED_LIBS", shared
	c.defineBool "BUILD_STATIC_LIBS", !shared
	c.defineBool "CMAKE_POSITION_INDEPENDENT_CODE", fPIC
	c.defineBool "JSONCPP_WITH_CMAKE_PACKAGE", false
	c.defineBool "JSONCPP_WITH_PKGCONFIG_SUPPORT", false
	c.defineBool "JSONCPP_WITH_STRICT_ISO", false
	c.defineBool "JSONCPP_WITH_TESTS", false
	c.defineBool "JSONCPP_WITH_WARNING_AS_ERROR", false
	c.configure
	c.build
	c.install

	licenseDir := filepath.join(installDir, "licenses")
	os.mkdirAll(licenseDir, 0o755)!
	os.writeFile(filepath.join(licenseDir, "LICENSE"), os.readFile(filepath.join(ctx.SourceDir, "LICENSE"))!, 0o644)!

	libs := ["-L$${libdir}", "-ljsoncpp"]
	if slices.contains(target.require["os"], "linux") || slices.contains(target.require["os"], "freebsd") {
		libs <- "-lm"
	}

	cflags := ["-I$${includedir}"]
	if shared && slices.contains(target.require["os"], "windows") {
		cflags <- "-DJSON_DLL"
	}

	pcDir := filepath.join(installDir, "lib", "pkgconfig")
	os.mkdirAll(pcDir, 0o755)!
	pc := pkgconfig.new(
		name = "jsoncpp",
		description = "A C++ library for interacting with JSON",
		version = "1.8.3",
		URL = "https://github.com/open-source-parsers/jsoncpp",
		libs = libs,
		cflags = cflags,
	)!
	out := os.create(filepath.join(pcDir, "jsoncpp.pc"))!
	pc.writeTo(out)!
	out.close()!

	pkgconfig.use installDir
	ctx.setMetadata pkgconfig.lookup("jsoncpp")!
}

onTest ctx => {
	installDir := ctx.outputDir
	shared := target.options["shared"][0] == "ON"
	testDir := filepath.join(ctx.SourceDir, "_llar_consumer")
	os.mkdirAll(testDir, 0o755)!

	consumer := filepath.join(testDir, "consumer.cpp")
	os.writeFile(consumer, []byte(consumerSource), 0o644)!

	pkgconfig.use installDir
	flagsFile := filepath.join(testDir, "jsoncpp.flags")
	os.writeFile(flagsFile, []byte(pkgconfig.lookup("jsoncpp")!), 0o644)!

	binary := filepath.join(testDir, "consumer")
	exec! "c++", "-std=c++11", consumer, "-o", binary, "@"+flagsFile

	if shared {
		os.setenv("LD_LIBRARY_PATH", filepath.join(installDir, "lib"))!
		os.setenv("DYLD_LIBRARY_PATH", filepath.join(installDir, "lib"))!
		if slices.contains(target.require["os"], "windows") {
			systemPath := os.getenv("PATH")
			os.setenv("PATH", filepath.join(installDir, "bin")+";"+systemPath)!
		}
	}
	exec! binary
}
