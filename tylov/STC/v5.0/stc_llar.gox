import (
	"os"
	"path/filepath"
)

const consumerSource = `#include <stdlib.h>

#include <stc/cstr.h>

#define i_type vec_i, int
#include <stc/vec.h>

int main(void) {
    cstr text = cstr_from("linked");
    cstr_drop(&text);

    vec_i vec = {0};
    vec_i_push(&vec, 10);
    vec_i_push(&vec, 20);
    vec_i_drop(&vec);
    return EXIT_SUCCESS;
}
`

id "tylov/STC"

fromVer "v5.0"

onBuild ctx => {
	installDir := ctx.outputDir
	buildDir := filepath.join(ctx.SourceDir, "_llar_stc_build")
	a := autotools.new(ctx.SourceDir, ctx.SourceDir, installDir)
	if target.require["os"][0] == "darwin" {
		// The upstream Makefile adds -Wno-clobbered for non-clang compilers;
		// Apple clang rejects that warning option under -Werror.
		a.build "lib", "BUILDDIR="+buildDir, "CC=clang"
	} else {
		a.build "lib", "BUILDDIR="+buildDir
	}
	archive := filepath.join(buildDir, "libstc.a")
	includeDir := filepath.join(installDir, "include")
	libDir := filepath.join(installDir, "lib")
	licenseDir := filepath.join(installDir, "licenses")
	os.mkdirAll(includeDir, 0o755)!
	os.mkdirAll(libDir, 0o755)!
	os.mkdirAll(licenseDir, 0o755)!
	for entry in filepath.glob(filepath.join(ctx.SourceDir, "include", "*"))! {
		cp! "-R", entry, includeDir
	}
	cp! archive, filepath.join(libDir, "libstc.a")
	cp! filepath.join(ctx.SourceDir, "LICENSE"), filepath.join(licenseDir, "LICENSE")

	pcDir := filepath.join(libDir, "pkgconfig")
	os.mkdirAll(pcDir, 0o755)!
	libs := ["-L$${libdir}", "-lstc"]
	if target.require["os"][0] != "windows" {
		libs <- "-lm"
	}
	pc := pkgconfig.new(
		name = "stc",
		description = "STC - Smart Template Containers",
		version = "v5.0",
		libs = libs,
		cflags = ["-I$${includedir}"],
	)!
	out := os.create(filepath.join(pcDir, "stc.pc"))!
	pc.writeTo(out)!
	out.close()!

	pkgconfig.use installDir
	ctx.setMetadata pkgconfig.lookup("stc")!
}

onTest ctx => {
	installDir := ctx.outputDir
	testDir := filepath.join(ctx.SourceDir, "_llar_consumer")
	os.mkdirAll(testDir, 0o755)!

	consumer := filepath.join(testDir, "consumer.c")
	os.writeFile(consumer, []byte(consumerSource), 0o644)!
	pkgconfig.use installDir
	flagsFile := filepath.join(testDir, "stc.flags")
	os.writeFile(flagsFile, []byte(pkgconfig.lookup("stc")!), 0o644)!

	binary := filepath.join(testDir, "consumer")
	cc! consumer, "-o", binary, "@"+flagsFile
	exec! binary
}
