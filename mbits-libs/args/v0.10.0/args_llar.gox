import (
	"os"
	"path/filepath"
	"strings"
)

const consumerSource = `#include <args/parser.hpp>
#include <algorithm>
#include <cstdio>
#include <numeric>
#include <vector>

template <typename Pred>
unsigned accumulate(std::vector<unsigned> const& integers, Pred pred) {
    return std::accumulate(integers.begin(), integers.end(), 0u, pred);
}

int main(int argc, char* argv[]) {
    std::vector<unsigned> integers{};
    bool is_sum{false};

    args::null_translator tr{};
    args::parser parser{"Process some integers.",
        args::from_main(argc, argv), &tr};
    parser.set<std::true_type>(is_sum, "sum")
        .opt()
        .help("sum the integers (default: find the max)");
    parser.arg(integers)
        .meta("N")
        .help("an integer for the accumulator");

    parser.parse();

    auto const result =
        is_sum ? accumulate(integers, [](auto a, auto b) { return a + b; })
               : accumulate(integers,
                            [](auto a, auto b) { return std::max(a, b); });
    printf("%u\n", result);
}
`

const consumerCMakeLists = `cmake_minimum_required(VERSION 3.12)
project(args_consumer LANGUAGES CXX)
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
add_executable(args_consumer consumer.cpp)
target_include_directories(args_consumer PRIVATE "INSTALL_DIR/include")
target_link_directories(args_consumer PRIVATE "INSTALL_DIR/lib")
target_link_libraries(args_consumer PRIVATE args)
`

var sourcePatch = `diff --git a/CMakeLists.txt b/CMakeLists.txt
index 3d9271c..28c176f 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -12,3 +11,0 @@ if (CMAKE_CURRENT_SOURCE_DIR STREQUAL CMAKE_SOURCE_DIR)
-  include($${CMAKE_BINARY_DIR}/conanbuildinfo.cmake)
-  conan_basic_setup(TARGETS)
-
`

id "mbits-libs/args"

fromVer "v0.10.0"

onBuild ctx => {
	installDir := ctx.outputDir
	_, err := os.stat(filepath.join(ctx.SourceDir, "conanfile.txt"))
	if err == nil {
		patchFile := filepath.join(ctx.SourceDir, "_llar.patch")
		os.writeFile(patchFile, []byte(sourcePatch), 0644)!
		git "apply", "--unidiff-zero", patchFile
		lastErr!
	} else if !os.isNotExist(err) {
		panic err
	}

	c := cmake.new(ctx.SourceDir, filepath.join(ctx.SourceDir, "_build"), installDir)
	c.defineBool "LIBARGS_TESTING", false
	c.defineBool "LIBARGS_INSTALL", true
	c.configure
	c.build
	c.install

	flags := []string{
		"-I" + filepath.join(installDir, "include"),
		"-L" + filepath.join(installDir, "lib"),
		"-largs",
	}
	ctx.setMetadata strings.join(flags, " ")
}

onTest ctx => {
	installDir := ctx.outputDir
	testDir := filepath.join(ctx.SourceDir, "_llar_consumer")
	testBuild := filepath.join(testDir, "_build")

	os.mkdirAll(testDir, 0755)!
	os.writeFile(filepath.join(testDir, "consumer.cpp"), []byte(consumerSource), 0644)!
	os.writeFile(filepath.join(testDir, "CMakeLists.txt"), []byte(strings.replace(consumerCMakeLists, "INSTALL_DIR", installDir, -1)), 0644)!

	tc := cmake.new(testDir, testBuild, "")
	tc.configure
	tc.build

	exec filepath.join(testBuild, "args_consumer"), "--sum", "1", "2", "3"
	lastErr!
}
