import (
	"os"
	"path/filepath"
	"slices"
)

id "wdas/ptex"

fromVer "v2.4.2"

defaults {
	"shared": "OFF",
	"fPIC": "ON",
}

filter => {
	if !slices.contains(target.require["os"], "linux") && !slices.contains(target.require["os"], "darwin") {
		return false
	}
	for name, values in target.options {
		if name != "shared" && name != "fPIC" {
			return false
		}
		for value in values {
			if value != "ON" && value != "OFF" {
				return false
			}
		}
	}
	return true
}

onRequire (proj, deps) => {
	deps.require "madler/zlib", "v1.3.1"
}

onBuild ctx => {
	installDir := ctx.outputDir
	shared := target.options["shared"][0] == "ON"
	fPIC := target.options["fPIC"][0] == "ON"

	c := cmake.new(ctx.SourceDir, filepath.join(ctx.SourceDir, "_llar_build"), installDir)
	c.buildType "Release"
	c.define "CMAKE_INSTALL_LIBDIR", "lib"
	c.defineBool "CMAKE_POSITION_INDEPENDENT_CODE", fPIC
	c.defineBool "PTEX_BUILD_STATIC_LIBS", !shared
	c.defineBool "PTEX_BUILD_SHARED_LIBS", shared
	for dep in ctx.Proj.Deps {
		c.use ctx.outputDir(dep)
	}
	c.configure
	c.build
	c.install

	licenseDir := filepath.join(installDir, "licenses")
	os.mkdirAll(licenseDir, 0o755)!
	os.writeFile(filepath.join(licenseDir, "LICENSE"), os.readFile(filepath.join(ctx.SourceDir, "LICENSE"))!, 0o644)!

	libs := ["-L$${libdir}", "-lPtex"]
	if slices.contains(target.require["os"], "linux") {
		libs <- "-pthread"
	}
	cflags := ["-I$${includedir}"]
	if !shared {
		cflags <- "-DPTEX_STATIC"
	}
	pcDir := filepath.join(installDir, "lib", "pkgconfig")
	os.mkdirAll(pcDir, 0o755)!
	pc := pkgconfig.new(
		name = "ptex",
		description = "Per-face texture mapping system",
		version = "v2.4.2",
		requires = ["zlib"],
		libs = libs,
		cflags = cflags,
	)!
	pcFile := os.create(filepath.join(pcDir, "ptex.pc"))!
	pc.writeTo(pcFile)!
	pcFile.close()!

	for dep in ctx.Proj.Deps {
		pkgconfig.use ctx.outputDir(dep)
	}
	pkgconfig.use installDir
	ctx.setMetadata pkgconfig.lookup("ptex")!
}

onTest ctx => {
	installDir := ctx.outputDir
	testDir := filepath.join(ctx.SourceDir, "_llar_consumer")
	os.mkdirAll(testDir, 0o755)!
	consumer := filepath.join(testDir, "consumer.cpp")
	os.writeFile(consumer, ctx.Proj.readFile("consumer.cpp")!, 0o644)!

	for dep in ctx.Proj.Deps {
		pkgconfig.use ctx.outputDir(dep)
	}
	pkgconfig.use installDir
	flagsFile := filepath.join(testDir, "ptex.flags")
	os.writeFile(flagsFile, []byte(pkgconfig.lookup("ptex")!), 0o644)!
	binary := filepath.join(testDir, "consumer")
	exec! "c++", consumer, "@"+flagsFile, "-o", binary
	if target.options["shared"][0] == "ON" {
		os.setenv("LD_LIBRARY_PATH", filepath.join(installDir, "lib"))!
		os.setenv("DYLD_LIBRARY_PATH", filepath.join(installDir, "lib"))!
	}
	exec! binary
}
