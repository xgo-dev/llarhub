import (
	"strconv"
	"strings"
)

func releaseVersion(version string) (string, bool) {
	if version.hasPrefix("mbedtls-") {
		version = "v" + version.trimPrefix("mbedtls-")
	} else if version.hasPrefix("polarssl-") {
		version = "v" + version.trimPrefix("polarssl-")
	} else if !version.hasPrefix("v") {
		return "", false
	}

	if semver.isValid(version) {
		return version, true
	}

	withoutPrefix := version[1:]
	if i := strings.indexByte(withoutPrefix, '-'); i >= 0 {
		core := withoutPrefix[:i]
		parts := strings.split(core, ".")
		if parts.len == 2 {
			return "v" + core + ".0" + withoutPrefix[i:], true
		}
	}

	parts := strings.split(withoutPrefix, ".")
	if parts.len == 4 {
		patch := strconv.atoi(parts[2])!
		next := patch + 1
		return "v" + parts[0] + "." + parts[1] + "." + next.string + "-" + parts[3], true
	}

	post := ""
	if version.hasSuffix("p1") {
		post = "1"
	}
	if post != "" {
		core := version.trimSuffix("p1")
		parts := strings.split(core[1:], ".")
		if parts.len == 3 {
			patch := strconv.atoi(parts[2])!
			next := patch + 1
			return "v" + parts[0] + "." + parts[1] + "." + next.string + "-p" + post, true
		}
	}

	dev := ""
	if version.hasSuffix("d0") {
		dev = "0"
	} else if version.hasSuffix("d1") {
		dev = "1"
	} else if version.hasSuffix("d2") {
		dev = "2"
	}
	if dev != "" {
		core := version.trimSuffix("d" + dev)
		parts := strings.split(core[1:], ".")
		if parts.len == 3 {
			return core + "-dev." + dev, true
		}
	}

	return "", false
}

compareVer (a, b) => {
	aVersion, aRelease := releaseVersion(a.Version)
	bVersion, bRelease := releaseVersion(b.Version)
	if aRelease && bRelease {
		cmp := semver.compare(aVersion, bVersion)
		if cmp != 0 {
			return cmp
		}
	} else if aRelease {
		return 1
	} else if bRelease {
		return -1
	}
	return strings.compare(a.Version, b.Version)
}
