import (
	"os"
	"path/filepath"
)

id "lz4/lz4"

fromVer "v1.10.0"

defaults {
	"shared": "OFF",
	"fPIC": "ON",
}

filter => {
	for name, values in target.options {
		if name != "shared" && name != "fPIC" {
			return false
		}
		for value in values {
			if value != "ON" && value != "OFF" {
				return false
			}
		}
	}
	return true
}

onBuild ctx => {
	installDir := ctx.outputDir
	shared := target.options["shared"][0] == "ON"
	fPIC := target.options["fPIC"][0] == "ON"

	c := cmake.new(filepath.join(ctx.SourceDir, "build", "cmake"), filepath.join(ctx.SourceDir, "_build"), installDir)
	c.buildType "Release"
	c.define "CMAKE_INSTALL_LIBDIR", "lib"
	c.defineBool "BUILD_SHARED_LIBS", shared
	c.defineBool "BUILD_STATIC_LIBS", !shared
	c.defineBool "LZ4_BUILD_CLI", false
	c.defineBool "LZ4_BUNDLED_MODE", false
	c.defineBool "LZ4_POSITION_INDEPENDENT_LIB", fPIC
	c.configure
	c.build
	c.install

	licenseDir := filepath.join(installDir, "licenses")
	os.mkdirAll(licenseDir, 0o755)!
	os.writeFile(filepath.join(licenseDir, "LICENSE"), os.readFile(filepath.join(ctx.SourceDir, "LICENSE"))!, 0o644)!

	cflags := ["-I$${includedir}"]
	if shared && target.require["os"][0] == "windows" {
		cflags <- "-DLZ4_DLL_IMPORT=1"
	}

	pcDir := filepath.join(installDir, "lib", "pkgconfig")
	os.mkdirAll(pcDir, 0o755)!
	pc := pkgconfig.new(
		name = "liblz4",
		description = "extremely fast lossless compression algorithm library",
		version = "v1.10.0",
		libs = ["-L$${libdir}", "-llz4"],
		cflags = cflags,
	)!
	out := os.create(filepath.join(pcDir, "liblz4.pc"))!
	pc.writeTo(out)!
	out.close()!

	pkgconfig.use installDir
	ctx.setMetadata pkgconfig.lookup("liblz4")!
}

onTest ctx => {
	installDir := ctx.outputDir
	testDir := filepath.join(ctx.SourceDir, "_llar_consumer")
	os.mkdirAll(testDir, 0o755)!

	consumer := filepath.join(testDir, "consumer.c")
	os.writeFile(consumer, ctx.Proj.readFile("v1.10.0/consumer.c")!, 0o644)!

	pkgconfig.use installDir
	flagsFile := filepath.join(testDir, "liblz4.flags")
	os.writeFile(flagsFile, []byte(pkgconfig.lookup("liblz4")!), 0o644)!

	binary := filepath.join(testDir, "consumer")
	cc! consumer, "-o", binary, "@"+flagsFile

	if target.options["shared"][0] == "ON" {
		os.setenv("LD_LIBRARY_PATH", filepath.join(installDir, "lib"))!
		os.setenv("DYLD_LIBRARY_PATH", filepath.join(installDir, "lib"))!
	}
	exec! binary
}
