import "strings"

// The repository keeps historical year tags alongside version tags. The
// aliases below resolve to the same release commits; the remaining synthetic
// values preserve the complete tag chronology proved from the upstream refs.
func normalize(version string) string {
	switch version {
	case "v3.0.0":
		return "v0.1.0"
	case "v3.1.0":
		return "v0.2.0"
	case "2002.1", "v4.0.0":
		return "v0.3.0"
	case "2003.1", "v4.1.0":
		return "v0.4.0"
	case "2009.1", "v5.0.0.0":
		return "v0.5.0"
	case "v3.0":
		return "v0.6.0"
	case "2009.1.1", "v5.0.0.1":
		return "v0.7.0"
	case "2010.1", "v6.1.0":
		return "v0.8.0"
	case "2011.1", "v6.2.0":
		return "v0.9.0"
	case "2011.2", "v6.2.1":
		return "v0.10.0"
	case "2012.1", "v6.3.1.1494":
		return "v0.11.0"
	case "2015.1", "v7.1.0":
		return "v0.12.0"
	case "2015.2", "v7.2.0":
		return "v0.13.0"
	case "v7.3.0":
		return "v0.14.0"
	case "v7.2.1":
		return "v0.15.0"
	case "v7.3.1":
		return "v0.16.0"
	case "2019.1", "v7.3.2":
		return "v0.17.0"
	case "2020.1", "v8.0.0":
		return "v0.18.0"
	case "v8.0.1":
		return "v0.19.0"
	case "2020.2", "v8.0.2":
		return "v0.20.0"
	case "v8.1-alpha1":
		return "v0.21.0"
	case "v8.1-alpha2":
		return "v0.22.0"
	case "v8.1-alpha3":
		return "v0.23.0"
	case "v8.1-alpha4":
		return "v0.24.0"
	case "v8.1.alpha4":
		return "v0.25.0"
	case "v8.1-alpha5":
		return "v0.26.0"
	case "v8.1-alpha6":
		return "v0.27.0"
	}
	return "v0.0.0-" + strings.replaceAll(version, ".", "-")
}

compareVer (a, b) => {
	return semver.Compare(normalize(a.Version), normalize(b.Version))
}
