import (
	"os"
	"path/filepath"
)

const consumerSource = `#include <imgui.h>

int main() {
    ImGuiContext* context = ImGui::CreateContext();
    if (context == nullptr || ImGui::GetVersion() == nullptr) {
        return 1;
    }
    ImGui::DestroyContext();
    return 0;
}
`

id "ocornut/imgui"

fromVer "v1.85"

defaults {
	"shared": "OFF",
	"fPIC": "ON",
}

filter => {
	for name, values in target.options {
		if name != "shared" && name != "fPIC" {
			return false
		}
		for value in values {
			if value != "ON" && value != "OFF" {
				return false
			}
		}
	}

	if target.require["os"].len != 1 {
		return false
	}
	osName := target.require["os"][0]
	return osName == "linux" || osName == "darwin" || osName == "windows"
}

onBuild ctx => {
	installDir := ctx.outputDir
	shared := target.options["shared"][0] == "ON"
	fPIC := target.options["fPIC"][0] == "ON"
	osName := target.require["os"][0]

	cmakeLists := ctx.Proj.readFile("v1.85/CMakeLists.txt")!
	os.writeFile(filepath.join(ctx.SourceDir, "CMakeLists.txt"), cmakeLists, 0o644)!

	c := cmake.new(ctx.SourceDir, filepath.join(ctx.SourceDir, "_build"), installDir)
	c.define "CMAKE_INSTALL_LIBDIR", "lib"
	c.define "IMGUI_SRC_DIR", ctx.SourceDir
	c.defineBool "BUILD_SHARED_LIBS", shared
	if !shared && osName != "windows" {
		c.defineBool "CMAKE_POSITION_INDEPENDENT_CODE", fPIC
	}
	c.configure
	c.build
	c.install

	licenseDir := filepath.join(installDir, "licenses")
	os.mkdirAll(licenseDir, 0o755)!
	os.writeFile(filepath.join(licenseDir, "LICENSE.txt"), os.readFile(filepath.join(ctx.SourceDir, "LICENSE.txt"))!, 0o644)!

	bindingsDir := filepath.join(installDir, "res", "bindings")
	os.mkdirAll(bindingsDir, 0o755)!
	for sourcePath in filepath.glob(filepath.join(ctx.SourceDir, "backends", "imgui_impl_*"))! {
		os.writeFile(filepath.join(bindingsDir, filepath.base(sourcePath)), os.readFile(sourcePath)!, 0o644)!
	}

	sourceDir := filepath.join(installDir, "res", "src")
	os.mkdirAll(sourceDir, 0o755)!
	for sourcePath in filepath.glob(filepath.join(ctx.SourceDir, "imgui*.cpp"))! {
		os.writeFile(filepath.join(sourceDir, filepath.base(sourcePath)), os.readFile(sourcePath)!, 0o644)!
	}

	cppDir := filepath.join(installDir, "res", "misc", "cpp")
	os.mkdirAll(cppDir, 0o755)!
	for sourcePath in filepath.glob(filepath.join(ctx.SourceDir, "misc", "cpp", "*.*"))! {
		os.writeFile(filepath.join(cppDir, filepath.base(sourcePath)), os.readFile(sourcePath)!, 0o644)!
	}

	freetypeDir := filepath.join(installDir, "res", "misc", "freetype")
	os.mkdirAll(freetypeDir, 0o755)!
	for sourcePath in filepath.glob(filepath.join(ctx.SourceDir, "misc", "freetype", "*.*"))! {
		os.writeFile(filepath.join(freetypeDir, filepath.base(sourcePath)), os.readFile(sourcePath)!, 0o644)!
	}

	libs := ["-L$${libdir}", "-limgui"]
	if osName == "linux" {
		libs <- "-lm"
	} else if osName == "windows" {
		libs <- "-limm32"
	}

	pcDir := filepath.join(installDir, "lib", "pkgconfig")
	os.mkdirAll(pcDir, 0o755)!
	pc := pkgconfig.new(
		name = "imgui",
		description = "Bloat-free Immediate Mode Graphical User interface for C++ with minimal dependencies",
		version = "v1.85",
		libs = libs,
		cflags = ["-I$${includedir}", "-DIMGUI_USER_CONFIG=\\\"imgui_export_headers.h\\\""],
	)!
	out := os.create(filepath.join(pcDir, "imgui.pc"))!
	pc.writeTo(out)!
	out.close()!

	pkgconfig.use installDir
	ctx.setMetadata pkgconfig.lookup("imgui")!
}

onTest ctx => {
	installDir := ctx.outputDir
	testDir := filepath.join(ctx.SourceDir, "_llar_consumer")
	os.mkdirAll(testDir, 0o755)!

	consumer := filepath.join(testDir, "consumer.cpp")
	os.writeFile(consumer, []byte(consumerSource), 0o644)!

	pkgconfig.use installDir
	flagsFile := filepath.join(testDir, "imgui.flags")
	os.writeFile(flagsFile, []byte(pkgconfig.lookup("imgui")!), 0o644)!

	binary := filepath.join(testDir, "consumer")
	exec! "c++", "-std=c++11", consumer, "-o", binary, "@"+flagsFile

	if target.options["shared"][0] == "ON" {
		os.setenv("LD_LIBRARY_PATH", filepath.join(installDir, "lib"))!
		os.setenv("DYLD_LIBRARY_PATH", filepath.join(installDir, "lib"))!
		if target.require["os"][0] == "windows" {
			os.setenv("PATH", filepath.join(installDir, "bin")+";"+os.getenv("PATH"))!
		}
	}
	exec! binary
}
