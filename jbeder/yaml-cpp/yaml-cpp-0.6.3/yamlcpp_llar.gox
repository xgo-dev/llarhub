import (
	"os"
	"path/filepath"
)

const consumerSource = `#include <string>

#include "yaml-cpp/yaml.h"

int main() {
    YAML::Node primes = YAML::Load("[2, 3, 5, 7, 11]");
    if (primes.size() != 5 || primes[2].as<int>() != 5) {
        return 1;
    }

    YAML::Emitter emitter;
    emitter << YAML::BeginMap;
    emitter << YAML::Key << "name";
    emitter << YAML::Value << "Ryan Braun";
    emitter << YAML::Key << "position";
    emitter << YAML::Value << "LF";
    emitter << YAML::EndMap;
    if (!emitter.good()) {
        return 2;
    }

    YAML::Node player = YAML::Load(emitter.c_str());
    if (player["position"].as<std::string>() != "LF") {
        return 3;
    }
    return 0;
}
`

id "jbeder/yaml-cpp"

fromVer "yaml-cpp-0.6.3"

defaults {
	"shared": "OFF",
	"fPIC": "ON",
}

filter => {
	for name, values in target.options {
		if name != "shared" && name != "fPIC" {
			return false
		}
		for value in values {
			if value != "ON" && value != "OFF" {
				return false
			}
		}
	}
	return true
}

onBuild ctx => {
	installDir := ctx.outputDir
	shared := target.options["shared"][0] == "ON"
	fPIC := target.options["fPIC"][0] == "ON"
	osName := target.require["os"][0]

	c := cmake.new(ctx.SourceDir, filepath.join(ctx.SourceDir, "_build"), installDir)
	c.define "CMAKE_INSTALL_LIBDIR", "lib"
	c.define "CMAKE_POLICY_VERSION_MINIMUM", "3.5"
	c.defineBool "YAML_CPP_BUILD_TESTS", false
	c.defineBool "YAML_CPP_BUILD_CONTRIB", true
	c.defineBool "YAML_CPP_BUILD_TOOLS", false
	c.defineBool "YAML_CPP_INSTALL", true
	c.defineBool "YAML_BUILD_SHARED_LIBS", shared
	if !shared {
		c.defineBool "CMAKE_POSITION_INDEPENDENT_CODE", fPIC
	}
	c.configure
	c.build
	c.install

	licenseDir := filepath.join(installDir, "licenses")
	os.mkdirAll(licenseDir, 0o755)!
	os.writeFile(filepath.join(licenseDir, "LICENSE"), os.readFile(filepath.join(ctx.SourceDir, "LICENSE"))!, 0o644)!

	libs := ["-L$${libdir}", "-lyaml-cpp"]
	if osName == "linux" || osName == "freebsd" {
		libs <- "-lm"
	}

	cflags := ["-I$${includedir}"]
	if !shared {
		cflags <- "-DYAML_CPP_STATIC_DEFINE"
	} else if osName == "windows" {
		cflags <- "-DYAML_CPP_DLL"
	}

	pcDir := filepath.join(installDir, "lib", "pkgconfig")
	os.mkdirAll(pcDir, 0o755)!
	pc := pkgconfig.new(
		name = "Yaml-cpp",
		description = "A YAML parser and emitter for C++",
		version = "0.6.3",
		libs = libs,
		cflags = cflags,
	)!
	out := os.create(filepath.join(pcDir, "yaml-cpp.pc"))!
	pc.writeTo(out)!
	out.close()!

	pkgconfig.use installDir
	ctx.setMetadata pkgconfig.lookup("yaml-cpp")!
}

onTest ctx => {
	installDir := ctx.outputDir
	testDir := filepath.join(ctx.SourceDir, "_llar_consumer")
	os.mkdirAll(testDir, 0o755)!

	sourcePath := filepath.join(testDir, "consumer.cpp")
	os.writeFile(sourcePath, []byte(consumerSource), 0o644)!

	pkgconfig.use installDir
	flagsPath := filepath.join(testDir, "yaml-cpp.flags")
	os.writeFile(flagsPath, []byte(pkgconfig.lookup("yaml-cpp")!), 0o644)!

	binary := filepath.join(testDir, "consumer")
	exec! "c++", "-std=c++11", sourcePath, "-o", binary, "@"+flagsPath

	if target.options["shared"][0] == "ON" {
		os.setenv("LD_LIBRARY_PATH", filepath.join(installDir, "lib"))!
		os.setenv("DYLD_LIBRARY_PATH", filepath.join(installDir, "lib"))!
		if target.require["os"][0] == "windows" {
			os.setenv("PATH", filepath.join(installDir, "bin"))!
		}
	}
	exec! binary
}
