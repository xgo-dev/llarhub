import (
	"os"
	"path/filepath"
)

const consumerSource = `#include <cstdlib>
#include <iostream>
#include <stringzilla.h>

int main(void) {
  sz_string_view_t haystack = {
    "Fastest string sort, search, split, "
    "and shuffle for long strings and multi-gigabyte files in Python and C, "
    "leveraging SIMD with Arm Neon and x86 AVX2 & AVX-512 intrinsics.",
    171};
  sz_string_view_t needle = {"SIMD", 4};

  // Perform string-level operations
  sz_size_t character_count = sz_count_char(haystack.start, haystack.length, "a");
  sz_string_start_t substring_position = sz_find_substring(
    haystack.start, haystack.length,
    needle.start, needle.length
  );

  // Hash strings
  sz_u32_t crc32 = sz_hash_crc32(haystack.start, haystack.length);

  return EXIT_SUCCESS;
}
`

id "ashvardanian/StringZilla"

fromVer "v2.0.0"

onBuild ctx => {
	installDir := ctx.outputDir
	sourceDir := filepath.join(ctx.SourceDir, "stringzilla")
	includeDir := filepath.join(installDir, "include")
	os.mkdirAll(includeDir, 0o755)!

	walkErr := filepath.walkDir(sourceDir, (sourcePath, entry, err) => {
		if err != nil {
			return err
		}
		if entry.isDir || !entry.name.hasSuffix(".h") {
			return nil
		}

		relativePath := filepath.rel(sourceDir, sourcePath)!
		destination := filepath.join(includeDir, relativePath)
		os.mkdirAll(filepath.dir(destination), 0o755)!
		os.writeFile(destination, os.readFile(sourcePath)!, 0o644)!
		return nil
	})
	if walkErr != nil {
		panic walkErr
	}

	licensePath := filepath.join(ctx.SourceDir, "LICENSE")
	if _, err := os.stat(licensePath); err == nil {
		licenseDir := filepath.join(installDir, "licenses")
		os.mkdirAll(licenseDir, 0o755)!
		os.writeFile(filepath.join(licenseDir, "LICENSE"), os.readFile(licensePath)!, 0o644)!
	} else if !os.isNotExist(err) {
		panic err
	}

	pcDir := filepath.join(installDir, "lib", "pkgconfig")
	os.mkdirAll(pcDir, 0o755)!
	pc := pkgconfig.new(
		name = "stringzilla",
		description = "Fastest string sort, search, split, and shuffle for long strings and multi-gigabyte files",
		version = "v2.0.0",
		cflags = ["-I$${includedir}"],
	)!
	out := os.create(filepath.join(pcDir, "stringzilla.pc"))!
	pc.writeTo(out)!
	out.close()!

	pkgconfig.use installDir
	ctx.setMetadata pkgconfig.lookup("stringzilla")!
}

onTest ctx => {
	installDir := ctx.outputDir
	testDir := filepath.join(ctx.SourceDir, "_llar_consumer")
	os.mkdirAll(testDir, 0o755)!

	consumer := filepath.join(testDir, "consumer.cpp")
	os.writeFile(consumer, []byte(consumerSource), 0o644)!

	pkgconfig.use installDir
	flagsFile := filepath.join(testDir, "stringzilla.flags")
	os.writeFile(flagsFile, []byte(pkgconfig.lookup("stringzilla")!), 0o644)!

	binary := filepath.join(testDir, "consumer")
	exec! "c++", "-std=c++11", consumer, "-o", binary, "@"+flagsFile
	exec! binary
}
