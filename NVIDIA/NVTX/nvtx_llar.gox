import (
	"os"
	"path/filepath"
)

const consumerSource = `#include <stdlib.h>
#include <nvtx3/nvToolsExt.h>

int main(void) {
    nvtxInitialize(NULL);
    nvtxRangeId_t main_range = nvtxRangeStartA("main");
    nvtxRangeEnd(main_range);
    return EXIT_SUCCESS;
}
`

id "NVIDIA/NVTX"

fromVer "v3.0.1"

onBuild ctx => {
	installDir := ctx.outputDir
	includeDir := filepath.join(installDir, "include")
	os.mkdirAll(includeDir, 0o755)!

	sourceInclude := filepath.join(ctx.SourceDir, "c", "include")
	_, err := os.stat(sourceInclude)
	if err != nil {
		if !os.isNotExist(err) {
			panic err
		}
		sourceInclude = filepath.join(ctx.SourceDir, "include")
	}
	cp! "-R", filepath.join(sourceInclude, "nvtx3"), includeDir

	licensePath := filepath.join(ctx.SourceDir, "LICENSE.txt")
	_, err = os.stat(licensePath)
	if err == nil {
		licenseDir := filepath.join(installDir, "licenses")
		os.mkdirAll(licenseDir, 0o755)!
		cp! licensePath, filepath.join(licenseDir, "LICENSE.txt")
	} else if !os.isNotExist(err) {
		panic err
	}

	libs := []string{}
	osName := target.require["os"][0]
	if osName == "linux" || osName == "freebsd" {
		libs <- "-ldl"
	}

	pcDir := filepath.join(installDir, "lib", "pkgconfig")
	os.mkdirAll(pcDir, 0o755)!
	pc := pkgconfig.new(
		name = "nvtx",
		description = "The NVIDIA Tools Extension SDK",
		version = "v3.0.1",
		libs = libs,
		cflags = ["-I$${includedir}"],
	)!
	out := os.create(filepath.join(pcDir, "nvtx.pc"))!
	pc.writeTo(out)!
	out.close()!

	pkgconfig.use installDir
	ctx.setMetadata pkgconfig.lookup("nvtx")!
}

onTest ctx => {
	installDir := ctx.outputDir
	testDir := filepath.join(ctx.SourceDir, "_llar_consumer")
	os.mkdirAll(testDir, 0o755)!

	consumer := filepath.join(testDir, "consumer.c")
	os.writeFile(consumer, []byte(consumerSource), 0o644)!

	pkgconfig.use installDir
	flagsFile := filepath.join(testDir, "nvtx.flags")
	os.writeFile(flagsFile, []byte(pkgconfig.lookup("nvtx")!), 0o644)!

	binary := filepath.join(testDir, "consumer")
	cc! consumer, "-o", binary, "@"+flagsFile
	exec! binary
}
