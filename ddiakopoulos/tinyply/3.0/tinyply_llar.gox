import (
	"os"
	"path/filepath"
	"slices"
	"strings"
)

const consumerSource = `#include <tinyply.h>

int main() {
    tinyply::PlyFile file;
    return 0;
}
`

id "ddiakopoulos/tinyply"

fromVer "3.0"

defaults {
	"shared": "OFF",
	"fPIC": "ON",
}

filter => {
	for name, values in target.options {
		if name != "shared" && name != "fPIC" {
			return false
		}
		for value in values {
			if value != "ON" && value != "OFF" {
				return false
			}
		}
	}
	return true
}

onBuild ctx => {
	installDir := ctx.outputDir
	shared := target.options["shared"][0] == "ON"
	fPIC := target.options["fPIC"][0] == "ON"

	c := cmake.new(ctx.SourceDir, filepath.join(ctx.SourceDir, "_build"), installDir)
	c.define "CMAKE_INSTALL_LIBDIR", "lib"
	c.define "CMAKE_POLICY_VERSION_MINIMUM", "3.5"
	c.defineBool "SHARED_LIB", shared
	c.defineBool "BUILD_TESTS", false
	c.defineBool "CMAKE_POSITION_INDEPENDENT_CODE", fPIC
	c.configure
	c.build
	c.install

	readme := string(os.readFile(filepath.join(ctx.SourceDir, "README.md"))!)
	licenseStart := strings.index(readme, "## License")
	if licenseStart < 0 {
		panic "README.md has no ## License section"
	}
	licenseDir := filepath.join(installDir, "licenses")
	os.mkdirAll(licenseDir, 0o755)!
	os.writeFile(filepath.join(licenseDir, "LICENSE"), []byte(readme[licenseStart:]), 0o644)!

	pcPath := filepath.join(installDir, "lib", "pkgconfig", "tinyply.pc")
	pc := string(os.readFile(pcPath)!)
	pc = strings.replace(pc, "prefix="+installDir, "prefix=$${pcfiledir}/../..", 1)
	pc = strings.replace(pc, "exec_prefix="+installDir, "exec_prefix=$${prefix}", 1)
	pc = strings.replace(pc, "libdir="+filepath.join(installDir, "lib"), "libdir=$${prefix}/lib", 1)
	pc = strings.replace(pc, "includedir="+filepath.join(installDir, "include"), "includedir=$${prefix}/include", 1)
	lines := pc.split("\n")
	for i, line in lines {
		if line.hasPrefix("Libs:") && slices.contains(target.require["os"], "linux") && !strings.contains(line, " -lm") {
			line += " -lm"
		}
		lines[i] = line
	}
	os.writeFile(pcPath, []byte(strings.join(lines, "\n")), 0o644)!

	pkgconfig.use installDir
	ctx.setMetadata pkgconfig.lookup("tinyply")!
}

onTest ctx => {
	installDir := ctx.outputDir
	testDir := filepath.join(ctx.SourceDir, "_llar_consumer")
	os.mkdirAll(testDir, 0o755)!

	consumer := filepath.join(testDir, "consumer.cpp")
	os.writeFile(consumer, []byte(consumerSource), 0o644)!

	pkgconfig.use installDir
	flagsFile := filepath.join(testDir, "tinyply.flags")
	os.writeFile(flagsFile, []byte(pkgconfig.lookup("tinyply")!), 0o644)!

	binary := filepath.join(testDir, "consumer")
	exec! "c++", "-std=c++11", consumer, "-o", binary, "@"+flagsFile

	if target.options["shared"][0] == "ON" {
		os.setenv("LD_LIBRARY_PATH", filepath.join(installDir, "lib"))!
		os.setenv("DYLD_LIBRARY_PATH", filepath.join(installDir, "lib"))!
	}
	exec! binary
}
