import (
	"os"
	"path/filepath"
	"slices"
	"strings"
)

id "LoicMarechal/libMeshb"

fromVer "v8.02"

defaults {
	"shared": "OFF",
	"fPIC": "ON",
	"with_gmf_asio": "OFF",
}

filter => {
	for name, values in target.options {
		if name != "shared" && name != "fPIC" && name != "with_gmf_asio" {
			return false
		}
		for value in values {
			if value != "ON" && value != "OFF" {
				return false
			}
		}
	}
	return true
}

onBuild ctx => {
	installDir := ctx.outputDir
	shared := target.options["shared"][0] == "ON"
	fPIC := target.options["fPIC"][0] == "ON"
	withGmfAsio := target.options["with_gmf_asio"][0] == "ON"

	cmakeLists := filepath.join(ctx.SourceDir, "CMakeLists.txt")
	source := string(os.readFile(cmakeLists)!)
	source = strings.replace(source, "add_subdirectory (examples)", "", 1)
	source = strings.replace(source, "install (FILES LICENSE.txt copyright.txt DESTINATION share/libMeshb)", "", 1)
	source = strings.replace(source, "install (DIRECTORY sample_meshes DESTINATION share/libMeshb)", "", 1)
	os.writeFile(cmakeLists, []byte(source), 0o644)!

	sourcesLists := filepath.join(ctx.SourceDir, "sources", "CMakeLists.txt")
	sources := string(os.readFile(sourcesLists)!)
	sources = strings.replace(sources, "install(DIRECTORY ${CMAKE_Fortran_MODULE_DIRECTORY}/ DESTINATION include)", "", 1)
	os.writeFile(sourcesLists, []byte(sources), 0o644)!

	c := cmake.new(ctx.SourceDir, filepath.join(ctx.SourceDir, "_build"), installDir)
	c.define "CMAKE_INSTALL_LIBDIR", "lib"
	c.defineBool "BUILD_SHARED_LIBS", shared
	c.defineBool "CMAKE_POSITION_INDEPENDENT_CODE", fPIC
	c.defineBool "WITH_GMF_AIO", withGmfAsio
	c.configure
	c.build
	c.install

	licenseDir := filepath.join(installDir, "licenses")
	os.mkdirAll(licenseDir, 0o755)!
	os.writeFile(filepath.join(licenseDir, "LICENSE.txt"), os.readFile(filepath.join(ctx.SourceDir, "LICENSE.txt"))!, 0o644)!

	major := ""
	minor := ""
	for line in string(os.readFile(cmakeLists)!).split("\n") {
		fields := strings.fields(line)
		if fields.len < 3 || fields[0] != "set" {
			continue
		}
		name := strings.trim(fields[1], "()")
		value := strings.trim(fields[2], "()")
		if name == "libMeshb_VERSION_MAJOR" {
			major = value
		}
		if name == "libMeshb_VERSION_MINOR" {
			minor = value
		}
	}
	if major == "" || minor == "" {
		panic "libMeshb CMakeLists.txt has no project version"
	}
	version := major + "." + minor

	libs := "-lMeshb.8"
	if slices.contains(target.require["os"], "linux") {
		libs += " -lrt -lm"
	}

	pcDir := filepath.join(installDir, "lib", "pkgconfig")
	os.mkdirAll(pcDir, 0o755)!
	pc := `prefix=$${pcfiledir}/../..
exec_prefix=$${prefix}
libdir=$${prefix}/lib
includedir=$${prefix}/include

Name: libmeshb
Description: A library to handle the *.meshb file format.
Version: ${version}
Libs: -L$${libdir} ${libs}
Cflags: -I$${includedir}
`
	os.writeFile(filepath.join(pcDir, "libmeshb.pc"), []byte(pc), 0o644)!

	pkgconfig.use installDir
	ctx.setMetadata pkgconfig.lookup("libmeshb")!
}

onTest ctx => {
	installDir := ctx.outputDir
	testDir := filepath.join(ctx.SourceDir, "_llar_consumer")
	os.mkdirAll(testDir, 0o755)!

	meshPath := filepath.join(testDir, "consumer.mesh")
	consumerSource := `#include <libmeshb8.h>

int main(void) {
    int ver = 0;
    int dim = 0;
    int64_t idx = GmfOpenMesh("${meshPath}", GmfWrite, 1, 3);
    if (idx == 0) {
        return 1;
    }
    GmfCloseMesh(idx);
    idx = GmfOpenMesh("${meshPath}", GmfRead, &ver, &dim);
    if (idx == 0) {
        return 1;
    }
    GmfCloseMesh(idx);
    return (ver == 1 && dim == 3) ? 0 : 1;
}
`
	consumer := filepath.join(testDir, "consumer.c")
	os.writeFile(consumer, []byte(consumerSource), 0o644)!

	pkgconfig.use installDir
	flagsFile := filepath.join(testDir, "libmeshb.flags")
	os.writeFile(flagsFile, []byte(pkgconfig.lookup("libmeshb")!), 0o644)!

	binary := filepath.join(testDir, "consumer")
	cc! consumer, "-o", binary, "@"+flagsFile

	if target.options["shared"][0] == "ON" {
		os.setenv("LD_LIBRARY_PATH", filepath.join(installDir, "lib"))!
		os.setenv("DYLD_LIBRARY_PATH", filepath.join(installDir, "lib"))!
	}
	exec! binary
}
