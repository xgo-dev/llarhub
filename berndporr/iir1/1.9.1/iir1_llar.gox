import (
	"os"
	"path/filepath"
	"slices"
)

const consumerSource = `#include "Iir.h"

int main() {
    const int order = 8;
    Iir::Butterworth::LowPass<order> filter;
    return 0;
}
`

id "berndporr/iir1"

fromVer "1.9.1"

defaults {
	"shared": "OFF",
	"fPIC": "ON",
	"noexceptions": "OFF",
}

filter => {
	if !slices.contains(target.require["os"], "linux") && !slices.contains(target.require["os"], "darwin") {
		return false
	}
	if !slices.contains(target.require["arch"], "amd64") && !slices.contains(target.require["arch"], "arm64") {
		return false
	}
	for name, values in target.options {
		if name != "shared" && name != "fPIC" && name != "noexceptions" {
			return false
		}
		for value in values {
			if value != "ON" && value != "OFF" {
				return false
			}
		}
	}
	return true
}

onBuild ctx => {
	installDir := ctx.outputDir
	shared := target.options["shared"][0] == "ON"
	fPIC := target.options["fPIC"][0] == "ON"
	noExceptions := target.options["noexceptions"][0] == "ON"

	c := cmake.new(ctx.SourceDir, filepath.join(ctx.SourceDir, "_build"), installDir)
	c.define "CMAKE_INSTALL_LIBDIR", "lib"
	c.define "CMAKE_POLICY_VERSION_MINIMUM", "3.5"
	c.defineBool "CMAKE_POSITION_INDEPENDENT_CODE", fPIC
	if noExceptions {
		c.define "CMAKE_CXX_FLAGS", "-DIIR1_NO_EXCEPTIONS"
	}
	c.configure
	c.build "--target", "iir", "iir_static"
	c.install

	if shared {
		for libraryFile in filepath.glob(filepath.join(installDir, "lib", "*iir_static.*"))! {
			os.remove(libraryFile)!
		}
	} else {
		for libraryFile in filepath.glob(filepath.join(installDir, "lib", "*iir.*"))! {
			os.remove(libraryFile)!
		}
	}
	os.removeAll(filepath.join(installDir, "lib", "cmake"))!

	licenseDir := filepath.join(installDir, "licenses")
	os.mkdirAll(licenseDir, 0o755)!
	os.writeFile(filepath.join(licenseDir, "COPYING"), os.readFile(filepath.join(ctx.SourceDir, "COPYING"))!, 0o644)!

	libs := ["-L$${libdir}"]
	if shared {
		libs <- "-liir"
	} else {
		libs <- "-liir_static"
	}
	if slices.contains(target.require["os"], "linux") {
		libs <- "-lm"
	}
	cflags := ["-I$${includedir}"]
	if noExceptions {
		cflags <- "-DIIR1_NO_EXCEPTIONS"
	}

	pcDir := filepath.join(installDir, "lib", "pkgconfig")
	os.mkdirAll(pcDir, 0o755)!
	pc := pkgconfig.new(
		name = "iir",
		description = "IIR filter library.",
		version = "1.9.1",
		libs = libs,
		cflags = cflags,
	)!
	out := os.create(filepath.join(pcDir, "iir.pc"))!
	pc.writeTo(out)!
	out.close()!

	pkgconfig.use installDir
	ctx.setMetadata pkgconfig.lookup("iir")!
}

onTest ctx => {
	installDir := ctx.outputDir
	testDir := filepath.join(ctx.SourceDir, "_llar_consumer")
	os.mkdirAll(testDir, 0o755)!

	sourcePath := filepath.join(testDir, "consumer.cpp")
	os.writeFile(sourcePath, []byte(consumerSource), 0o644)!

	pkgconfig.use installDir
	flagsFile := filepath.join(testDir, "iir.flags")
	os.writeFile(flagsFile, []byte(pkgconfig.lookup("iir")!), 0o644)!

	binary := filepath.join(testDir, "consumer")
	exec! "c++", "-std=c++11", sourcePath, "-o", binary, "@"+flagsFile

	if target.options["shared"][0] == "ON" {
		os.setenv("LD_LIBRARY_PATH", filepath.join(installDir, "lib"))!
		os.setenv("DYLD_LIBRARY_PATH", filepath.join(installDir, "lib"))!
	}
	exec! binary
}
