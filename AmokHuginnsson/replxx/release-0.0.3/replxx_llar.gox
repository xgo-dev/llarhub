import (
	"os"
	"path/filepath"
)

const consumerSource = `#include <functional>
#include <replxx.hxx>

int main() {
    using Replxx = replxx::Replxx;
    using namespace std::placeholders;

    Replxx rx;
    rx.install_window_change_handler();
    rx.set_max_hint_rows(3);
    rx.bind_key(Replxx::KEY::UP, std::bind(&Replxx::invoke, &rx,
                                           Replxx::ACTION::HISTORY_PREVIOUS, _1));
    rx.bind_key(Replxx::KEY::DOWN, std::bind(&Replxx::invoke, &rx,
                                             Replxx::ACTION::HISTORY_NEXT, _1));
    return 0;
}
`

id "AmokHuginnsson/replxx"

fromVer "release-0.0.3"

defaults {
	"shared": "OFF",
	"fPIC": "ON",
}

filter => {
	for name, values in target.options {
		if name != "shared" && name != "fPIC" {
			return false
		}
		for value in values {
			if value != "ON" && value != "OFF" {
				return false
			}
		}
	}
	return true
}

onBuild ctx => {
	installDir := ctx.outputDir
	shared := target.options["shared"][0] == "ON"
	fPIC := target.options["fPIC"][0] == "ON"

	c := cmake.new(ctx.SourceDir, filepath.join(ctx.SourceDir, "_build"), installDir)
	c.define "CMAKE_INSTALL_LIBDIR", "lib"
	c.defineBool "REPLXX_BUILD_EXAMPLES", false
	c.defineBool "REPLXX_BUILD_PACKAGE", false
	c.defineBool "BUILD_SHARED_LIBS", shared
	c.defineBool "CMAKE_POSITION_INDEPENDENT_CODE", fPIC
	c.configure
	c.build
	c.install

	licenseDir := filepath.join(installDir, "licenses")
	os.mkdirAll(licenseDir, 0o755)!
	os.writeFile(filepath.join(licenseDir, "LICENSE.md"), os.readFile(filepath.join(ctx.SourceDir, "LICENSE.md"))!, 0o644)!

	libs := ["-L$${libdir}", "-lreplxx"]
	cflags := ["-I$${includedir}"]
	if !shared {
		cflags <- "-DREPLXX_STATIC"
	}
	osName := target.require["os"][0]
	if osName == "linux" || osName == "freebsd" {
		libs <- "-lpthread"
		libs <- "-lm"
	}

	pcDir := filepath.join(installDir, "lib", "pkgconfig")
	os.mkdirAll(pcDir, 0o755)!
	pc := pkgconfig.new(
		name = "replxx",
		description = "Readline and libedit replacement library",
		version = "release-0.0.3",
		URL = "https://github.com/AmokHuginnsson/replxx",
		libs = libs,
		cflags = cflags,
	)!
	out := os.create(filepath.join(pcDir, "replxx.pc"))!
	pc.writeTo(out)!
	out.close()!

	pkgconfig.use installDir
	ctx.setMetadata pkgconfig.lookup("replxx")!
}

onTest ctx => {
	installDir := ctx.outputDir
	testDir := filepath.join(ctx.SourceDir, "_llar_consumer")
	os.mkdirAll(testDir, 0o755)!

	consumer := filepath.join(testDir, "consumer.cpp")
	os.writeFile(consumer, []byte(consumerSource), 0o644)!

	pkgconfig.use installDir
	flagsFile := filepath.join(testDir, "replxx.flags")
	os.writeFile(flagsFile, []byte(pkgconfig.lookup("replxx")!), 0o644)!

	binary := filepath.join(testDir, "consumer")
	exec! "c++", "-std=c++11", consumer, "-o", binary, "@"+flagsFile

	if target.options["shared"][0] == "ON" {
		os.setenv("LD_LIBRARY_PATH", filepath.join(installDir, "lib"))!
		os.setenv("DYLD_LIBRARY_PATH", filepath.join(installDir, "lib"))!
	}
	exec! binary
}
