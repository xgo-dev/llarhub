@@ -358,14 +356,12 @@ elseif(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
@@LLAR_CONTEXT@@	set(TINYSPLINE_LIBRARIES "$${TINYSPLINE_LIBRARIES} -lm")
@@LLAR_BLANK@@
@@LLAR_CONTEXT@@	# TINYSPLINE_LIBRARY_C_FLAGS
-	set(TINYSPLINE_LIBRARY_C_FLAGS "$${TINYSPLINE_LIBRARY_C_FLAGS} -Werror")
@@LLAR_CONTEXT@@	set(TINYSPLINE_LIBRARY_C_FLAGS "$${TINYSPLINE_LIBRARY_C_FLAGS} -Wall")
@@LLAR_CONTEXT@@	set(TINYSPLINE_LIBRARY_C_FLAGS "$${TINYSPLINE_LIBRARY_C_FLAGS} -Wextra")
@@LLAR_CONTEXT@@	set(TINYSPLINE_LIBRARY_C_FLAGS "$${TINYSPLINE_LIBRARY_C_FLAGS} -Wfloat-equal")
@@LLAR_CONTEXT@@	set(TINYSPLINE_LIBRARY_C_FLAGS "$${TINYSPLINE_LIBRARY_C_FLAGS} -pedantic")
@@LLAR_BLANK@@
@@LLAR_CONTEXT@@	# TINYSPLINE_LIBRARY_CXX_FLAGS@@LLAR_TRAILING@@
-	set(TINYSPLINE_LIBRARY_CXX_FLAGS "$${TINYSPLINE_LIBRARY_CXX_FLAGS} -Werror")
@@LLAR_CONTEXT@@	set(TINYSPLINE_LIBRARY_CXX_FLAGS "$${TINYSPLINE_LIBRARY_CXX_FLAGS} -Wall")
@@LLAR_CONTEXT@@	set(TINYSPLINE_LIBRARY_CXX_FLAGS "$${TINYSPLINE_LIBRARY_CXX_FLAGS} -Wextra")
@@LLAR_CONTEXT@@	set(TINYSPLINE_LIBRARY_CXX_FLAGS "$${TINYSPLINE_LIBRARY_CXX_FLAGS} -Wfloat-equal")
@@ -386,11 +382,9 @@ elseif(CMAKE_CXX_COMPILER_ID MATCHES "MSVC")
@@LLAR_BLANK@@
@@LLAR_CONTEXT@@	# TINYSPLINE_LIBRARY_C_FLAGS
@@LLAR_CONTEXT@@	set(TINYSPLINE_LIBRARY_C_FLAGS "$${TINYSPLINE_LIBRARY_C_FLAGS} /Wall")
-	set(TINYSPLINE_LIBRARY_C_FLAGS "$${TINYSPLINE_LIBRARY_C_FLAGS} /WX")
@@LLAR_BLANK@@
@@LLAR_CONTEXT@@	# TINYSPLINE_LIBRARY_CXX_FLAGS
