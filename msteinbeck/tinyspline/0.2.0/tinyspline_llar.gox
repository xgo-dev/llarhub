import (
	"os"
	"strings"
	"path/filepath"
	"slices"
)

const consumerC = `#include <tinyspline.h>

int main() {
  tsBSpline spline;
  tsError status = ts_bspline_new(6, 3, 3, TS_OPENED, &spline);
  ts_bspline_free(&spline);
  return status == TS_SUCCESS ? 0 : 1;
}
`

const consumerCXX = `#include <tinysplinecpp.h>

int main() {
  tinyspline::BSpline spline(6, 3, 3);
  return 0;
}
`

var sourcePatch = `--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -9,7 +9,10 @@ set_property(GLOBAL PROPERTY USE_FOLDERS ON)
@@LLAR_CONTEXT@@add_subdirectory(src)
