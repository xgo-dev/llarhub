@@LLAR_BLANK@@
-add_subdirectory(examples)
-add_subdirectory(test)
-add_subdirectory(docs)
-add_subdirectory(tools)
+if(TINYSPLINE_BUILD_EXAMPLES)
+	add_subdirectory(examples)
+endif()
+if(TINYSPLINE_BUILD_TESTS)
+	enable_testing()
+	add_subdirectory(test)
+endif()
+if(TINYSPLINE_BUILD_DOCS)
+	add_subdirectory(docs)
+endif()
--- a/src/CMakeLists.txt
