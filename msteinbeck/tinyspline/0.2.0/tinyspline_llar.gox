@@LLAR_CONTEXT@@	add_library(tinyspline_shared SHARED $${TINYSPLINE_C_SOURCE_FILES})
+	if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
+		target_link_libraries(tinyspline_shared PRIVATE m)
