@@LLAR_CONTEXT@@			OUTPUT_NAME "tinysplinecpp"
@@ -512,7 +510,7 @@ if(NOT TINYSPLINE_DISABLE_CXX AND TINYSPLINE_CXX_AVAILABLE)
@@LLAR_CONTEXT@@			ARCHIVE DESTINATION lib
@@LLAR_CONTEXT@@			RUNTIME DESTINATION bin
