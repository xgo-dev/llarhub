@@LLAR_CONTEXT@@		OUTPUT_NAME "tinysplinecpp"
@@ -524,12 +522,13 @@ if(NOT TINYSPLINE_DISABLE_CXX AND TINYSPLINE_CXX_AVAILABLE)
@@LLAR_CONTEXT@@		LIBRARY DESTINATION lib
@@LLAR_CONTEXT@@		ARCHIVE DESTINATION lib
@@LLAR_CONTEXT@@	)
-	install(FILES tinysplinecpp.h
-		DESTINATION include
-	)
@@LLAR_CONTEXT@@	target_include_directories(tinysplinecpp_static
