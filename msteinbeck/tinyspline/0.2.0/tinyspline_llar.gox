@@LLAR_BLANK@@
`

id "msteinbeck/tinyspline"

fromVer "0.2.0"

defaults {
	"shared": "OFF",
	"fPIC": "ON",
	"cxx": "ON",
	"floating_point_precision": "double",
}

filter => {
	for name, values in target.options {
		if name != "shared" && name != "fPIC" && name != "cxx" && name != "floating_point_precision" {
			return false
		}
		for value in values {
			if name == "floating_point_precision" {
				if value != "double" && value != "single" {
					return false
				}
			} else if value != "ON" && value != "OFF" {
				return false
			}
		}
	}
	return true
}

onBuild ctx => {
	installDir := ctx.outputDir
	shared := target.options["shared"][0] == "ON"
	fPIC := target.options["fPIC"][0] == "ON"
	cxx := target.options["cxx"][0] == "ON"
	singlePrecision := target.options["floating_point_precision"][0] == "single"

	patchFile := filepath.join(ctx.SourceDir, "_llar.patch")
	patchContent := strings.replaceAll(sourcePatch, "@@LLAR_CONTEXT@@", " ")
	patchContent = strings.replaceAll(patchContent, "@@LLAR_BLANK@@", " ")
	patchContent = strings.replaceAll(patchContent, "@@LLAR_TRAILING@@", " ")
	os.writeFile(patchFile, []byte(patchContent), 0o644)!
	git! "apply", "--unidiff-zero", patchFile

	c := cmake.new(ctx.SourceDir, filepath.join(ctx.SourceDir, "_build"), installDir)
	c.define "CMAKE_POLICY_VERSION_MINIMUM", "3.5"
	c.defineBool "BUILD_SHARED_LIBS", shared
	c.defineBool "CMAKE_POSITION_INDEPENDENT_CODE", fPIC
	c.defineBool "TINYSPLINE_FLOAT_PRECISION", singlePrecision
	c.defineBool "TINYSPLINE_DISABLE_CXX", !cxx
	c.defineBool "TINYSPLINE_DISABLE_CSHARP", true
	c.defineBool "TINYSPLINE_DISABLE_D", true
	c.defineBool "TINYSPLINE_DISABLE_GOLANG", true
	c.defineBool "TINYSPLINE_DISABLE_JAVA", true
	c.defineBool "TINYSPLINE_DISABLE_LUA", true
	c.defineBool "TINYSPLINE_DISABLE_OCTAVE", true
	c.defineBool "TINYSPLINE_DISABLE_PHP", true
	c.defineBool "TINYSPLINE_DISABLE_PYTHON", true
	c.defineBool "TINYSPLINE_DISABLE_R", true
 c.defineBool "TINYSPLINE_DISABLE_RUBY", true
 c.defineBool "TINYSPLINE_BUILD_EXAMPLES", false
 c.defineBool "TINYSPLINE_BUILD_TESTS", false
 c.defineBool "TINYSPLINE_BUILD_DOCS", false
 c.configure
 c.build
 c.install

 licenseDir := filepath.join(installDir, "licenses")
 os.mkdirAll(licenseDir, 0o755)!
 os.writeFile(filepath.join(licenseDir, "LICENSE"), os.readFile(filepath.join(ctx.SourceDir, "LICENSE"))!, 0o644)!

 linuxOrFreeBSD := slices.contains(target.require["os"], "linux") || slices.contains(target.require["os"], "freebsd")
 cLibs := ["-L$${libdir}", "-ltinyspline"]
 if linuxOrFreeBSD {
  cLibs <- "-lm"
 }
 cFlags := ["-I$${includedir}"]
 cxxFlags := ["-I$${includedir}"]

 pcDir := filepath.join(installDir, "lib", "pkgconfig")
 os.mkdirAll(pcDir, 0o755)!
 cPC := pkgconfig.new(
  name = "tinyspline",
  description = "NURBS Library for a Multitude of Programming Languages",
  version = "0.2.0",
  libs = cLibs,
  cflags = cFlags,
 )!
 cOut := os.create(filepath.join(pcDir, "tinyspline.pc"))!
 cPC.writeTo(cOut)!
 cOut.close()!

 if cxx {
  cxxLibs := ["-L$${libdir}", "-ltinysplinecpp"]
  if linuxOrFreeBSD {
   cxxLibs <- "-lm"
  }
  cxxPC := pkgconfig.new(
   name = "tinysplinecpp",
   description = "TinySpline C++ wrapper",
   version = "0.2.0",
   libs = cxxLibs,
   cflags = cxxFlags,
 )!
 cxxOut := os.create(filepath.join(pcDir, "tinysplinecpp.pc"))!
 cxxPC.writeTo(cxxOut)!
 cxxOut.close()!
 }

 pkgconfig.use installDir
 lookupName := "tinyspline"
 if cxx {
  lookupName = "tinysplinecpp"
 }
 ctx.setMetadata pkgconfig.lookup(lookupName)!
}

onTest ctx => {
 installDir := ctx.outputDir
 testDir := filepath.join(ctx.SourceDir, "_llar_consumer")
 os.mkdirAll(testDir, 0o755)!

 cPath := filepath.join(testDir, "consumer.c")
 os.writeFile(cPath, []byte(consumerC), 0o644)!
 pkgconfig.use installDir
 cFlags := pkgconfig.lookup("tinyspline")!
 cFlagsPath := filepath.join(testDir, "tinyspline.flags")
 os.writeFile(cFlagsPath, []byte(cFlags), 0o644)!
 cBinary := filepath.join(testDir, "consumer-c")
 cc! cPath, "-o", cBinary, "@"+cFlagsPath

 if target.options["cxx"][0] == "ON" {
  cxxPath := filepath.join(testDir, "consumer.cpp")
  os.writeFile(cxxPath, []byte(consumerCXX), 0o644)!
  cxxFlags := pkgconfig.lookup("tinysplinecpp")!
  cxxFlagsPath := filepath.join(testDir, "tinysplinecpp.flags")
  os.writeFile(cxxFlagsPath, []byte(cxxFlags), 0o644)!
  cxxBinary := filepath.join(testDir, "consumer-cxx")
  exec! "c++", "-std=c++11", cxxPath, "-o", cxxBinary, "@"+cxxFlagsPath
  if target.options["shared"][0] == "ON" {
   os.setenv("LD_LIBRARY_PATH", filepath.join(installDir, "lib"))!
   os.setenv("DYLD_LIBRARY_PATH", filepath.join(installDir, "lib"))!
  }
  exec! cxxBinary
 }
 if target.options["shared"][0] == "ON" {
  os.setenv("LD_LIBRARY_PATH", filepath.join(installDir, "lib"))!
  os.setenv("DYLD_LIBRARY_PATH", filepath.join(installDir, "lib"))!
 }
 exec! cBinary
}
