@@LLAR_CONTEXT@@set(TINYSPLINE_CXX_SOURCE_FILES $${TINYSPLINE_CXX_SOURCE_FILES} PARENT_SCOPE)
@@LLAR_BLANK@@
@@LLAR_CONTEXT@@# C library
-if(TARGET_SUPPORTS_SHARED_LIBS)
