import (
	"os"
	"path/filepath"
	"slices"
	"strings"
)

const consumerSource = `#include "com/amazonaws/kinesis/video/client/Include.h"

int main(void) {
    PDoubleList list = NULL;
    if (doubleListCreate(&list) != STATUS_SUCCESS) {
        return 1;
    }
    return doubleListFree(list) == STATUS_SUCCESS ? 0 : 1;
}
`

id "awslabs/amazon-kinesis-video-streams-pic"

fromVer "v1.1.0"

defaults {
	"shared": "OFF",
	"fPIC": "ON",
}

filter => {
	for name, values in target.options {
		if name != "shared" && name != "fPIC" {
			return false
		}
		for value in values {
			if value != "ON" && value != "OFF" {
				return false
			}
		}
	}
	if target.options["shared"][0] == "ON" && !slices.contains(target.require["os"], "linux") {
		return false
	}
	return true
}

onBuild ctx => {
	installDir := ctx.outputDir
	shared := target.options["shared"][0] == "ON"
	fPIC := target.options["fPIC"][0] == "ON"

	cmakeLists := filepath.join(ctx.SourceDir, "CMakeLists.txt")
	source := string(os.readFile(cmakeLists)!)
	source = strings.replace(source, " -fPIC", "", 1)
	os.writeFile(cmakeLists, []byte(source), 0o644)!

	c := cmake.new(ctx.SourceDir, filepath.join(ctx.SourceDir, "_build"), installDir)
	c.define "CMAKE_INSTALL_LIBDIR", "lib"
	c.defineBool "BUILD_DEPENDENCIES", false
	c.defineBool "BUILD_SHARED_LIBS", shared
	c.defineBool "CMAKE_POSITION_INDEPENDENT_CODE", fPIC
	c.configure
	c.build
	c.install

	licenseDir := filepath.join(installDir, "licenses")
	os.mkdirAll(licenseDir, 0o755)!
	os.writeFile(filepath.join(licenseDir, "LICENSE"), os.readFile(filepath.join(ctx.SourceDir, "LICENSE"))!, 0o644)!

	linux := slices.contains(target.require["os"], "linux")
	for name in ["libkvspic", "libkvspicClient", "libkvspicState", "libkvspicUtils"] {
		pcPath := filepath.join(installDir, "lib", "pkgconfig", name+".pc")
		pc := string(os.readFile(pcPath)!)
		pc = strings.replace(pc, "prefix="+installDir, "prefix=$${pcfiledir}/../..", 1)
		pc = strings.replace(pc, "exec_prefix="+installDir, "exec_prefix=$${prefix}", 1)
		pc = strings.replace(pc, "libdir="+filepath.join(installDir, "lib"), "libdir=$${prefix}/lib", 1)
		pc = strings.replace(pc, "includedir="+filepath.join(installDir, "include"), "includedir=$${prefix}/include", 1)
		if linux && (name == "libkvspic" || name == "libkvspicUtils") {
			lines := pc.split("\n")
			for i, line in lines {
				if line.hasPrefix("Libs:") && !strings.contains(line, " -ldl") {
					lines[i] = line + " -ldl -lrt -lpthread"
				}
			}
			pc = strings.join(lines, "\n")
		}
		os.writeFile(pcPath, []byte(pc), 0o644)!
	}

	pkgconfig.use installDir
	ctx.setMetadata pkgconfig.lookup("libkvspic")!
}

onTest ctx => {
	installDir := ctx.outputDir
	testDir := filepath.join(ctx.SourceDir, "_llar_consumer")
	os.mkdirAll(testDir, 0o755)!

	sourcePath := filepath.join(testDir, "consumer.c")
	os.writeFile(sourcePath, []byte(consumerSource), 0o644)!

	pkgconfig.use installDir
	flagsFile := filepath.join(testDir, "libkvspic.flags")
	os.writeFile(flagsFile, []byte(pkgconfig.lookup("libkvspic")!), 0o644)!

	binary := filepath.join(testDir, "consumer")
	cc! sourcePath, "-o", binary, "@"+flagsFile

	if target.options["shared"][0] == "ON" {
		os.setenv("LD_LIBRARY_PATH", filepath.join(installDir, "lib"))!
		os.setenv("DYLD_LIBRARY_PATH", filepath.join(installDir, "lib"))!
	}
	exec! binary
}
