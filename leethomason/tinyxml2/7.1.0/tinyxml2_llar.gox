import (
	"os"
	"path/filepath"
	"slices"
	"strings"
)

const consumerSource = `#include <tinyxml2.h>

int main() {
  static const char* xml =
    "<?xml version=\"1.0\"?>"
    "<!DOCTYPE PLAY SYSTEM \"play.dtd\">"
    "<PLAY>"
    "<TITLE>A Midsummer Night's Dream</TITLE>"
    "</PLAY>";

  tinyxml2::XMLDocument doc;
  doc.Parse(xml);

  return doc.ErrorID();
}
`

id "leethomason/tinyxml2"

fromVer "7.1.0"

defaults {
	"shared": "OFF",
	"fPIC": "ON",
}

filter => {
	osValues, ok := target.require["os"]
	if !ok || osValues.len == 0 {
		return false
	}
	for name, values in target.options {
		if name != "shared" && name != "fPIC" {
			return false
		}
		for value in values {
			if value != "ON" && value != "OFF" {
				return false
			}
		}
	}
	return true
}

onBuild ctx => {
	installDir := ctx.outputDir
	shared := target.options["shared"][0] == "ON"
	fPIC := target.options["fPIC"][0] == "ON"

	cmakeLists := filepath.join(ctx.SourceDir, "CMakeLists.txt")
	source := string(os.readFile(cmakeLists)!)
	source = strings.replace(source, "\r\n", "\n", -1)
	source = strings.replace(source, `cmake_policy(VERSION 2.6)
if(POLICY CMP0063)
	cmake_policy(SET CMP0063 OLD)
endif()
`, "", 1)
	source = strings.replace(source, "set(CMAKE_POSITION_INDEPENDENT_CODE ON)\n", "", 1)
	os.writeFile(cmakeLists, []byte(source), 0o644)!

	c := cmake.new(ctx.SourceDir, filepath.join(ctx.SourceDir, "_build"), installDir)
	c.define "CMAKE_INSTALL_LIBDIR", "lib"
	c.define "CMAKE_POLICY_VERSION_MINIMUM", "3.5"
	c.defineBool "BUILD_TESTING", false
	c.defineBool "BUILD_SHARED_LIBS", shared
	if !shared {
		c.defineBool "CMAKE_POSITION_INDEPENDENT_CODE", fPIC
	}
	c.configure
	c.build
	c.install

	licenseDir := filepath.join(installDir, "licenses")
	os.mkdirAll(licenseDir, 0o755)!
	os.writeFile(filepath.join(licenseDir, "LICENSE.txt"), os.readFile(filepath.join(ctx.SourceDir, "LICENSE.txt"))!, 0o644)!

	cflags := ["-I$${includedir}"]
	if shared && slices.contains(target.require["os"], "windows") {
		cflags <- "-DTINYXML2_IMPORT"
	}

	pcDir := filepath.join(installDir, "lib", "pkgconfig")
	os.mkdirAll(pcDir, 0o755)!
	pc := pkgconfig.new(
		name = "TinyXML2",
		description = "simple, small, C++ XML parser",
		version = "7.1.0",
		libs = ["-L$${libdir}", "-ltinyxml2"],
		cflags = cflags,
	)!
	out := os.create(filepath.join(pcDir, "tinyxml2.pc"))!
	pc.writeTo(out)!
	out.close()!

	pkgconfig.use installDir
	ctx.setMetadata pkgconfig.lookup("tinyxml2")!
}

onTest ctx => {
	installDir := ctx.outputDir
	testDir := filepath.join(ctx.SourceDir, "_llar_consumer")
	os.mkdirAll(testDir, 0o755)!

	sourcePath := filepath.join(testDir, "consumer.cpp")
	os.writeFile(sourcePath, []byte(consumerSource), 0o644)!

	pkgconfig.use installDir
	flagsFile := filepath.join(testDir, "tinyxml2.flags")
	os.writeFile(flagsFile, []byte(pkgconfig.lookup("tinyxml2")!), 0o644)!

	binary := filepath.join(testDir, "consumer")
	exec! "c++", sourcePath, "-o", binary, "@"+flagsFile

	if target.options["shared"][0] == "ON" {
		if slices.contains(target.require["os"], "linux") {
			os.setenv("LD_LIBRARY_PATH", filepath.join(installDir, "lib"))!
		} else if slices.contains(target.require["os"], "darwin") {
			os.setenv("DYLD_LIBRARY_PATH", filepath.join(installDir, "lib"))!
		} else if slices.contains(target.require["os"], "windows") {
			os.setenv("PATH", filepath.join(installDir, "bin"))!
		}
	}
	exec! binary
}
